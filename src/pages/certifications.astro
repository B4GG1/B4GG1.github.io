---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getCertificationsTranslations,
} from '../i18n/certifications';
import {
  getLocaleFromPath,
} from '../i18n/helpers';

const locale =
  getLocaleFromPath(Astro.url.pathname);

const t =
  getCertificationsTranslations(locale);

const primaryCredentialData = {
  type: 'Quality Assurance certification',
  title: 'ISTQB Certified Tester',
  subtitle: 'Foundation Level',
  issuer: 'SJSI / ISTQB',
  date: '05 Apr 2023',
  credentialId: '20150/CTFL/2023',
  mark: 'CTFL',
  logo:
    '/assets/images/certifications/SJSI ISTQB.jpg',
  logoAlt: 'SJSI and ISTQB logo',
  description:
    'A formal software testing qualification confirming Foundation Level knowledge within the ISTQB certification framework.',
  documentLabel: 'View certificate',
  documents: [
    {
      src: '/certificates/istqb-ctfl.jpg',
      type: 'image',
      alt:
        'Physical ISTQB Certified Tester Foundation Level certificate awarded to Bartosz Girzecki.',
    },
  ],
};

const professionalProgramsData = [
  {
    number: '01',
    type: 'Professional program',
    title: 'Back-End Developer: Python',
    provider: 'Coders Lab',
    date: '01 Mar 2020',
    duration: '240 hours',
    credentialId: '5048/2020',
    mark: 'PY',
    logo:
      '/assets/images/certifications/Coderslab.jpg',
    logoAlt: 'Coders Lab logo',
    description:
      'An intensive practical backend development program combining programming, databases, web technologies and project work.',
    topics: [
      'Python',
      'Advanced Python',
      'Django',
      'REST',
      'Databases',
      'JavaScript',
      'Git & GitFlow',
      'Scrum & Agile',
    ],
    documentLabel: 'View diploma',
    documents: [
      {
        src:
          '/certificates/coderslab-diploma.jpg',
        type: 'image',
        alt:
          'Physical Coders Lab Back-End Developer Python course diploma awarded to Bartosz Girzecki.',
      },
      {
        src:
          '/certificates/coderslab-supplement-1.jpg',
        type: 'image',
        alt:
          'First page of the Coders Lab Back-End Developer Python diploma supplement.',
      },
      {
        src:
          '/certificates/coderslab-supplement-2.jpg',
        type: 'image',
        alt:
          'Second page of the Coders Lab Back-End Developer Python diploma supplement.',
      },
    ],
  },
  {
    number: '02',
    type: 'Instructor training',
    title:
      'Programming Trainer for Children and Youth',
    provider: 'Giganci Programowania',
    date: '02 Jul 2026',
    duration: 'Completed training',
    credentialId: null,
    mark: 'EDU',
    logo:
      '/assets/images/certifications/Giganci programowania.jpg',
    logoAlt: 'Giganci Programowania logo',
    description:
      'Training preparing participants to work as programming instructors for children and young people.',
    topics: [
      'Programming education',
      'Working with young learners',
      'Technical instruction',
      'Lesson delivery',
    ],
    documentLabel: 'View certificate',
    documents: [
      {
        src:
          '/certificates/programming-trainer.jpg',
        type: 'image',
        alt:
          'Physical programming trainer certificate issued by Giganci Programowania to Bartosz Girzecki.',
      },
    ],
  },
];

const courseGroupsData = [
  {
    number: '01',
    title: 'QA Automation',
    description:
      'Selected training directly supporting the transition toward Python-based test automation and technical QA.',
    courses: [
      {
        title:
          'Learn API Automation Testing with Python & BDD Framework',
        provider: 'Rahul Shetty Academy',
        date: '23 Apr 2026',
        duration: '11.5 hours',
        mark: 'API',
        credentialId:
          'UC-99ede9d0-1627-4bb8-9a7a-8bc2413c0641',
        documents: [
          {
            src:
              '/certificates/udemy-api-automation-python.jpg',
            type: 'image',
            alt:
              'Udemy certificate for API automation testing with Python and BDD.',
          },
        ],
      },
      {
        title:
          'Playwright PYTHON Automation Testing – From Zero to Expert',
        provider: 'Rahul Shetty Academy',
        date: '08 May 2026',
        duration: '13.5 hours',
        mark: 'PW',
        credentialId:
          'UC-e473814b-4fb3-4fa3-8a85-baf49390a606',
        documents: [
          {
            src:
              '/certificates/udemy-playwright-python.jpg',
            type: 'image',
            alt:
              'Udemy certificate for Playwright Python automation testing.',
          },
        ],
      },
      {
        title:
          'Selenium Webdriver with PYTHON from Scratch + Frameworks',
        provider: 'Rahul Shetty Academy',
        date: '13 May 2026',
        duration: '18 hours',
        mark: 'SEL',
        credentialId:
          'UC-291c4371-8482-4598-b362-f7ce64acc451',
        documents: [
          {
            src:
              '/certificates/udemy-selenium-python.jpg',
            type: 'image',
            alt:
              'Udemy certificate for Selenium WebDriver with Python.',
          },
        ],
      },
    ],
  },
  {
    number: '02',
    title: 'Programming & Game Development',
    description:
      'Programming foundations and practical development work focused on C++ and Unreal Engine systems.',
    courses: [
      {
        title:
          'Beginning C++ Programming – From Beginner to Beyond',
        provider:
          'Tim Buchalka’s Learn Programming Academy, Dr. Frank Mitropoulos',
        date: '12 Jan 2023',
        duration: '46 hours',
        mark: 'C++',
        credentialId:
          'UC-d8b45736-3d05-443f-8d02-3bb983d9c5c2',
        documents: [
          {
            src:
              '/certificates/udemy-cpp-beginning.jpg',
            type: 'image',
            alt:
              'Udemy certificate for Beginning C++ Programming.',
          },
        ],
      },
      {
        title:
          'Unreal Engine 5 C++: Advanced Action RPG',
        provider: 'Vince Petrelli',
        date: '06 Jan 2026',
        duration: '44 hours',
        mark: 'UE5',
        credentialId:
          'UC-798e58ea-bc4d-4c22-ad10-8bee71feff0c',
        documents: [
          {
            src:
              '/certificates/udemy-unreal-action-rpg.jpg',
            type: 'image',
            alt:
              'Udemy certificate for Unreal Engine 5 C++ Advanced Action RPG.',
          },
        ],
      },
    ],
  },
  {
    number: '03',
    title: '3D Creation',
    description:
      'Additional creative training supporting the production and understanding of three-dimensional game assets.',
    courses: [
      {
        title:
          'Complete Blender Creator: 3D Modelling',
        provider:
          'GameDev.tv Team, Rick Davidson, Grant Abbitt',
        date: '27 Feb 2026',
        duration: '14 hours',
        mark: '3D',
        credentialId:
          'UC-d02667c9-027d-45d7-aa4d-2db3d3aef2aa',
        documents: [
          {
            src:
              '/certificates/udemy-blender-creator.jpg',
            type: 'image',
            alt:
              'Udemy certificate for Complete Blender Creator 3D Modelling.',
          },
        ],
      },
    ],
  },
];

const selectedCourseHours = 147;

const primaryCredential = {
  ...primaryCredentialData,
  ...t.primaryCredential,
  documents:
    primaryCredentialData.documents.map(
      (document, index) => ({
        ...document,
        alt:
          t.primaryCredential.documentAlts[index] ??
          document.alt,
      })
    ),
};

const professionalPrograms =
  professionalProgramsData.map(
    (program, index) => {
      const localized =
        t.professionalPrograms[index];

      return {
        ...program,
        ...localized,
        documents:
          program.documents.map(
            (document, documentIndex) => ({
              ...document,
              alt:
                localized.documentAlts[
                  documentIndex
                ] ?? document.alt,
            })
          ),
      };
    }
  );

const courseGroups =
  courseGroupsData.map(
    (group, groupIndex) => {
      const localizedGroup =
        t.courseGroups[groupIndex];

      return {
        ...group,
        title: localizedGroup.title,
        description:
          localizedGroup.description,
        courses:
          group.courses.map(
            (course, courseIndex) => {
              const localizedCourse =
                localizedGroup.courses[
                  courseIndex
                ];

              return {
                ...course,
                ...localizedCourse,
                documents:
                  course.documents.map(
                    (document) => ({
                      ...document,
                      alt:
                        localizedCourse.documentAlt ??
                        document.alt,
                    })
                  ),
              };
            }
          ),
      };
    }
  );
---

<BaseLayout
  title={t.metadata.title}
  description={t.metadata.description}
  lang={locale}
>
  <section
    class="certifications-hero"
    aria-labelledby="certifications-title"
    data-certifications-hero
  >
    <h1 id="certifications-title">
      {t.hero.title}
    </h1>

    <p class="certifications-lead">
      {t.hero.lead}
    </p>
  </section>

  <section
    class="credential-stage"
    aria-labelledby="primary-credential-title"
    data-certification-target
  >
    <aside
      class="archive-index"
      aria-label={t.archive.aria}
    >
      <p class="archive-label">
        {t.archive.label}
      </p>

      <dl class="archive-stats">
        <div>
          <dt>{t.archive.qa}</dt>
          <dd>01</dd>
        </div>

        <div>
          <dt>{t.archive.programs}</dt>
          <dd>02</dd>
        </div>

        <div>
          <dt>{t.archive.hours}</dt>
          <dd>{selectedCourseHours}h</dd>
        </div>
      </dl>
    </aside>

    <article
      class="featured-credential"
      style="--reveal-delay: 100ms;"
    >
      <header class="credential-header">
        <div class="credential-type">
          <span aria-hidden="true"></span>
          {primaryCredential.type}
        </div>

        <div class="credential-reference">
          {t.labels.credentialNumber}
          <strong>
            {primaryCredential.credentialId}
          </strong>
        </div>
      </header>

      <div class="credential-main">
        <div
          class="credential-seal"
          aria-label={primaryCredential.logoAlt}
        >
          <img
            class="credential-logo"
            src={primaryCredential.logo}
            alt={primaryCredential.logoAlt}
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="credential-copy">
          <p class="credential-issuer">
            {primaryCredential.issuer}
          </p>

          <h2 id="primary-credential-title">
            {primaryCredential.title}
          </h2>

          <p class="credential-subtitle">
            {primaryCredential.subtitle}
          </p>

          <p class="credential-description">
            {primaryCredential.description}
          </p>
        </div>
      </div>

      <footer class="credential-footer">
        <div>
          <span>{t.labels.issuedTo}</span>
          <strong>Bartosz Girzecki</strong>
        </div>

        <div>
          <span>{t.labels.dateAwarded}</span>
          <strong>{primaryCredential.date}</strong>
        </div>

        <div>
          <span>{t.labels.status}</span>
          <strong class="credential-status">
            {t.labels.completed}
          </strong>
        </div>

        <button
          class="document-button"
          type="button"
          data-document-open
          data-document-title={`${primaryCredential.title} – ${primaryCredential.subtitle}`}
          data-document-images={JSON.stringify(
            primaryCredential.documents
          )}
        >
          <span>
            {primaryCredential.documentLabel}
          </span>

          <span aria-hidden="true">↗</span>
        </button>
      </footer>
    </article>
  </section>

  <section
    class="programs-section"
    aria-labelledby="programs-title"
    data-certification-target
  >
    <header class="section-heading">
      <div>
        <h2 id="programs-title">
          {t.programsSection.title}
        </h2>
      </div>

      <p>
        {t.programsSection.lead}
      </p>
    </header>

    <div class="program-grid">
      {
        professionalPrograms.map((program, index) => (
          <article
            class="program-card"
            style={`--reveal-delay: ${180 + index * 140}ms;`}
          >
            <div
              class="program-mark"
              aria-label={program.logoAlt}
            >
              <img
                class="program-logo"
                src={program.logo}
                alt={program.logoAlt}
                loading="lazy"
                decoding="async"
              />
            </div>

            <div class="program-content">
              <div class="program-meta">
                <span>{program.type}</span>
                <span>{program.date}</span>
              </div>

              <h3>{program.title}</h3>

              <p class="program-provider">
                {program.provider}
              </p>

              <p class="program-description">
                {program.description}
              </p>

              <ul class="program-topics">
                {
                  program.topics.map((topic) => (
                    <li>{topic}</li>
                  ))
                }
              </ul>

              <footer class="program-footer">
                <span class="program-footer-copy">
                  {program.duration}

                  {
                    program.credentialId && (
                      <>
                        , {t.labels.diploma} {program.credentialId}
                      </>
                    )
                  }
                </span>

                <button
                  class="document-button"
                  type="button"
                  data-document-open
                  data-document-title={program.title}
                  data-document-images={JSON.stringify(
                    program.documents
                  )}
                >
                  <span>
                    {program.documentLabel}
                  </span>

                  <span aria-hidden="true">↗</span>
                </button>
              </footer>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section
    class="course-archive"
    aria-labelledby="course-archive-title"
    data-certification-target
  >
    <header class="section-heading course-heading">
      <div>
        <h2 id="course-archive-title">
          {t.courseArchive.title}
        </h2>
      </div>

      <p>
        {t.courseArchive.lead}
      </p>
    </header>

    <div class="course-groups">
      {
        courseGroups.map((group, groupIndex) => (
          <section
            class="course-group"
            aria-labelledby={`course-group-${groupIndex}`}
          >
            <header class="course-group-header">
              <span
                class="course-group-number"
                aria-hidden="true"
              >
                {group.number}
              </span>

              <div>
                <h3 id={`course-group-${groupIndex}`}>
                  {group.title}
                </h3>

                <p>{group.description}</p>
              </div>
            </header>

            <div class="course-list">
              {
                group.courses.map((course, courseIndex) => (
                  <article
                    class="course-card"
                    style={`--reveal-delay: ${
                      260 +
                      groupIndex * 130 +
                      courseIndex * 80
                    }ms;`}
                  >
                    <div
                      class="course-mark"
                      aria-label="Udemy"
                    >
                      <img
                        class="course-logo"
                        src="/assets/images/certifications/Udemy.jpg"
                        alt="Udemy logo"
                        loading="lazy"
                        decoding="async"
                      />
                    </div>

                    <div class="course-content">
                      <div class="course-meta">
                        <span>Udemy</span>
                        <span>{course.date}</span>
                      </div>

                      <h4>{course.title}</h4>

                      <p class="course-provider">
                        {course.provider}
                      </p>

                      <div class="course-details">
                        <span>{course.duration}</span>

                        <span>
                          {course.credentialId}
                        </span>
                      </div>
                    </div>

                    <button
                      class="course-link"
                      type="button"
                      data-document-open
                      data-document-title={course.title}
                      data-document-images={JSON.stringify(
                        course.documents
                      )}
                    >
                      <span>{t.courseArchive.viewCredential}</span>
                      <span aria-hidden="true">↗</span>
                    </button>
                  </article>
                ))
              }
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <dialog
    class="document-dialog"
    aria-label={t.document.preview}
    data-document-dialog
  >
    <button
      class="document-dialog-close"
      type="button"
      aria-label={t.document.close}
      data-document-close
    >
      <span aria-hidden="true">×</span>
    </button>


    <div
      class="document-gallery"
      data-document-gallery
    ></div>


  </dialog>

  <nav
    class="certification-navigation is-hidden"
    aria-label={t.navigation.aria}
    aria-hidden="true"
    data-certification-navigation
  >
    <button
      class="certification-navigation-button is-unavailable"
      type="button"
      aria-label={t.navigation.previous}
      aria-hidden="true"
      disabled
      data-certification-up
    >
      <span aria-hidden="true">↑</span>
    </button>

    <span class="certification-navigation-label">
      {t.navigation.label}
    </span>

    <button
      class="certification-navigation-button"
      type="button"
      aria-label={t.navigation.next}
      data-certification-down
    >
      <span aria-hidden="true">↓</span>
    </button>
  </nav>
</BaseLayout>

<script>
  const certificationsHero =
    document.querySelector(
      '[data-certifications-hero]'
    );

  const certificationSectionHeadings =
    Array.from(
      document.querySelectorAll(
        '.section-heading'
      )
    ).filter(
      (heading) =>
        heading instanceof HTMLElement
    );

  const certificationTargets =
    Array.from(
      document.querySelectorAll(
        '[data-certification-target]'
      )
    ).filter(
      (target) =>
        target instanceof HTMLElement
    );

  const certificationNavigation =
    document.querySelector(
      '[data-certification-navigation]'
    );

  const certificationUpButton =
    document.querySelector(
      '[data-certification-up]'
    );

  const certificationDownButton =
    document.querySelector(
      '[data-certification-down]'
    );

  const documentDialog =
    document.querySelector(
      '[data-document-dialog]'
    );

  const documentGallery =
    document.querySelector(
      '[data-document-gallery]'
    );

  const documentCloseButton =
    document.querySelector(
      '[data-document-close]'
    );

  const documentOpenButtons =
    document.querySelectorAll(
      '[data-document-open]'
    );

  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const compactHeroRatio = 0.6;
  const narrowNavigationRatio = 0.85;
  const compactNavigationRatio = 0.7;

  let activeCertificationIndex = 0;
  let navigationUpdatePending = false;
  let lastDocumentTrigger = null;

  const getResponsiveThreshold = (
    ratio
  ) => {
    const availableScreenWidth =
      window.screen.availWidth ||
      window.screen.width ||
      window.innerWidth;

    return (
      availableScreenWidth *
      ratio
    );
  };

  const updateCertificationsHeroMode =
    () => {
      const shouldUseStackedLayout =
        window.innerWidth <= 760 ||
        window.innerWidth <=
          getResponsiveThreshold(
            compactHeroRatio
          );

      if (
        certificationsHero instanceof
        HTMLElement
      ) {
        certificationsHero.classList.toggle(
          'is-stacked',
          shouldUseStackedLayout
        );
      }

      certificationSectionHeadings.forEach(
        (heading) => {
          heading.classList.toggle(
            'is-stacked',
            shouldUseStackedLayout
          );
        }
      );
    };

  const updateNavigationMode = () => {
    if (
      !(
        certificationNavigation instanceof
        HTMLElement
      )
    ) {
      return;
    }

    const shouldUseCompactNavigation =
      window.innerWidth <=
        getResponsiveThreshold(
          compactNavigationRatio
        );

    const shouldUseNarrowNavigation =
      window.innerWidth <=
        getResponsiveThreshold(
          narrowNavigationRatio
        ) &&
      !shouldUseCompactNavigation;

    certificationNavigation.classList.toggle(
      'is-narrow',
      shouldUseNarrowNavigation
    );

    certificationNavigation.classList.toggle(
      'is-compact',
      shouldUseCompactNavigation
    );
  };

  const setButtonAvailability = (
    button,
    isAvailable
  ) => {
    if (
      !(
        button instanceof
        HTMLButtonElement
      )
    ) {
      return;
    }

    button.disabled = !isAvailable;

    button.classList.toggle(
      'is-unavailable',
      !isAvailable
    );

    button.setAttribute(
      'aria-hidden',
      String(!isAvailable)
    );
  };

  const scrollToCertificationTarget = (
    targetIndex
  ) => {
    const target =
      certificationTargets[targetIndex];

    if (!(target instanceof HTMLElement)) {
      return;
    }

    target.scrollIntoView({
      behavior:
        reducedMotion.matches
          ? 'auto'
          : 'smooth',
      block: 'start',
    });
  };

  const updateCertificationNavigation =
    () => {
      if (
        !(
          certificationNavigation instanceof
          HTMLElement
        ) ||
        certificationTargets.length === 0
      ) {
        return;
      }

      updateCertificationsHeroMode();
      updateNavigationMode();

      const firstTarget =
        certificationTargets[0];

      const lastTarget =
        certificationTargets[
          certificationTargets.length - 1
        ];

      if (
        !(firstTarget instanceof HTMLElement) ||
        !(lastTarget instanceof HTMLElement)
      ) {
        return;
      }

      const firstPosition =
        firstTarget.getBoundingClientRect();

      const lastPosition =
        lastTarget.getBoundingClientRect();

      const navigationRangeIsVisible =
        firstPosition.top <
          window.innerHeight * 0.9 &&
        lastPosition.bottom >
          window.innerHeight * 0.1;

      certificationNavigation.classList.toggle(
        'is-hidden',
        !navigationRangeIsVisible
      );

      certificationNavigation.setAttribute(
        'aria-hidden',
        String(
          !navigationRangeIsVisible
        )
      );

      if (!navigationRangeIsVisible) {
        return;
      }

      const activationLine =
        window.innerHeight * 0.32;

      activeCertificationIndex = 0;

      certificationTargets.forEach(
        (target, index) => {
          const position =
            target.getBoundingClientRect();

          if (
            position.top <=
            activationLine
          ) {
            activeCertificationIndex =
              index;
          }
        }
      );

      setButtonAvailability(
        certificationUpButton,
        activeCertificationIndex > 0
      );

      setButtonAvailability(
        certificationDownButton,
        activeCertificationIndex <
          certificationTargets.length - 1
      );
    };

  const requestNavigationUpdate =
    () => {
      if (navigationUpdatePending) {
        return;
      }

      navigationUpdatePending = true;

      window.requestAnimationFrame(
        () => {
          updateCertificationNavigation();
          navigationUpdatePending = false;
        }
      );
    };

  if (
    certificationUpButton instanceof
    HTMLButtonElement
  ) {
    certificationUpButton.addEventListener(
      'click',
      () => {
        scrollToCertificationTarget(
          activeCertificationIndex - 1
        );
      }
    );
  }

  if (
    certificationDownButton instanceof
    HTMLButtonElement
  ) {
    certificationDownButton.addEventListener(
      'click',
      () => {
        scrollToCertificationTarget(
          activeCertificationIndex + 1
        );
      }
    );
  }

  const closeDocumentDialog = () => {
    if (
      !(
        documentDialog instanceof
        HTMLDialogElement
      )
    ) {
      return;
    }

    documentDialog.close();
  };


  let activeDocumentEntries = [];
  let activeDocumentIndex = 0;
  let activeDocumentTitle =
    'Document preview';

  const fitDocumentImage = (
    image
  ) => {
    if (
      !(
        image instanceof
        HTMLImageElement
      ) ||
      !(
        documentDialog instanceof
        HTMLDialogElement
      ) ||
      !(
        documentGallery instanceof
        HTMLElement
      ) ||
      image.naturalWidth <= 0 ||
      image.naturalHeight <= 0
    ) {
      return;
    }

    const page =
      image.closest(
        '.document-page'
      );

    if (!(page instanceof HTMLElement)) {
      return;
    }

    const viewportWidth =
      window.visualViewport?.width ??
      window.innerWidth;

    const viewportHeight =
      window.visualViewport?.height ??
      window.innerHeight;

    const isMobile =
      viewportWidth <= 600;

    const outerMargin =
      isMobile
        ? 12
        : 28;

    const availableWidth =
      Math.max(
        1,
        viewportWidth -
          outerMargin * 2
      );

    const availableHeight =
      Math.max(
        1,
        viewportHeight -
          outerMargin * 2
      );

    const widthScale =
      availableWidth /
      image.naturalWidth;

    const heightScale =
      availableHeight /
      image.naturalHeight;

    const scale =
      Math.min(
        widthScale,
        heightScale
      ) * 0.85;

    const renderedWidth =
      Math.max(
        1,
        Math.floor(
          image.naturalWidth *
          scale
        )
      );

    const renderedHeight =
      Math.max(
        1,
        Math.floor(
          image.naturalHeight *
          scale
        )
      );

    documentDialog.style.setProperty(
      'width',
      `${renderedWidth}px`,
      'important'
    );

    documentDialog.style.setProperty(
      'height',
      `${renderedHeight}px`,
      'important'
    );

    documentDialog.style.setProperty(
      'min-width',
      '0',
      'important'
    );

    documentDialog.style.setProperty(
      'min-height',
      '0',
      'important'
    );

    documentDialog.style.setProperty(
      'max-width',
      'none',
      'important'
    );

    documentDialog.style.setProperty(
      'max-height',
      'none',
      'important'
    );

    documentDialog.style.setProperty(
      'padding',
      '0',
      'important'
    );

    documentDialog.style.setProperty(
      'margin',
      'auto',
      'important'
    );

    documentDialog.style.setProperty(
      'border',
      '0',
      'important'
    );

    documentDialog.style.setProperty(
      'overflow',
      'visible',
      'important'
    );

    documentDialog.style.setProperty(
      'background',
      'transparent',
      'important'
    );

    documentGallery.style.setProperty(
      'box-sizing',
      'border-box',
      'important'
    );

    documentGallery.style.setProperty(
      'width',
      `${renderedWidth}px`,
      'important'
    );

    documentGallery.style.setProperty(
      'height',
      `${renderedHeight}px`,
      'important'
    );

    documentGallery.style.setProperty(
      'min-width',
      '0',
      'important'
    );

    documentGallery.style.setProperty(
      'min-height',
      '0',
      'important'
    );

    documentGallery.style.setProperty(
      'margin',
      '0',
      'important'
    );

    documentGallery.style.setProperty(
      'padding',
      '0',
      'important'
    );

    documentGallery.style.setProperty(
      'display',
      'block',
      'important'
    );

    documentGallery.style.setProperty(
      'overflow',
      'hidden',
      'important'
    );

    page.style.setProperty(
      'box-sizing',
      'border-box',
      'important'
    );

    page.style.setProperty(
      'width',
      `${renderedWidth}px`,
      'important'
    );

    page.style.setProperty(
      'height',
      `${renderedHeight}px`,
      'important'
    );

    page.style.setProperty(
      'min-width',
      '0',
      'important'
    );

    page.style.setProperty(
      'min-height',
      '0',
      'important'
    );

    page.style.setProperty(
      'max-width',
      'none',
      'important'
    );

    page.style.setProperty(
      'max-height',
      'none',
      'important'
    );

    page.style.setProperty(
      'margin',
      '0',
      'important'
    );

    page.style.setProperty(
      'padding',
      '0',
      'important'
    );

    page.style.setProperty(
      'display',
      'block',
      'important'
    );

    page.style.setProperty(
      'overflow',
      'hidden',
      'important'
    );

    image.style.setProperty(
      'width',
      `${renderedWidth}px`,
      'important'
    );

    image.style.setProperty(
      'height',
      `${renderedHeight}px`,
      'important'
    );

    image.style.setProperty(
      'min-width',
      '0',
      'important'
    );

    image.style.setProperty(
      'min-height',
      '0',
      'important'
    );

    image.style.setProperty(
      'max-width',
      'none',
      'important'
    );

    image.style.setProperty(
      'max-height',
      'none',
      'important'
    );

    image.style.setProperty(
      'margin',
      '0',
      'important'
    );

    image.style.setProperty(
      'padding',
      '0',
      'important'
    );

    image.style.setProperty(
      'display',
      'block',
      'important'
    );

    image.style.setProperty(
      'object-fit',
      'contain',
      'important'
    );

    image.style.setProperty(
      'object-position',
      'center center',
      'important'
    );
  };
  const renderActiveDocument = () => {
    if (
      !(
        documentGallery instanceof
        HTMLElement
      )
    ) {
      return;
    }

    documentGallery.replaceChildren();

    const entry =
      activeDocumentEntries[
        activeDocumentIndex
      ];

    if (
      !entry ||
      entry.type !== 'image' ||
      typeof entry.src !== 'string'
    ) {
      const placeholder =
        document.createElement('p');

      placeholder.className =
        'document-placeholder';

      placeholder.textContent =
        'Document preview is unavailable.';

      documentGallery.append(
        placeholder
      );

      return;
    }

    const page =
      document.createElement(
        'figure'
      );

    page.className =
      'document-page';

    const image =
      document.createElement(
        'img'
      );

    image.src = entry.src;

    image.alt =
      typeof entry.alt === 'string'
        ? entry.alt
        : activeDocumentTitle;

    image.loading = 'eager';
    image.decoding = 'async';

    image.addEventListener(
      'load',
      () => {
        window.requestAnimationFrame(
          () => {
            fitDocumentImage(
              image
            );
          }
        );
      }
    );

    page.append(image);

    if (
      documentCloseButton instanceof
      HTMLButtonElement
    ) {
      page.append(
        documentCloseButton
      );
    }

    if (
      activeDocumentEntries.length > 1
    ) {
      const previousButton =
        document.createElement(
          'button'
        );

      previousButton.className =
        'document-carousel-control document-carousel-previous';

      previousButton.type =
        'button';

      previousButton.setAttribute(
        'aria-label',
        'Show previous document page'
      );

      const previousIcon =
        document.createElement(
          'span'
        );

      previousIcon.textContent =
        '←';

      previousIcon.setAttribute(
        'aria-hidden',
        'true'
      );

      previousButton.append(
        previousIcon
      );

      previousButton.style.setProperty(
        'position',
        'absolute',
        'important'
      );

      previousButton.style.setProperty(
        'top',
        '50%',
        'important'
      );

      previousButton.style.setProperty(
        'left',
        '1rem',
        'important'
      );

      previousButton.style.setProperty(
        'z-index',
        '100',
        'important'
      );

      previousButton.style.setProperty(
        'width',
        '3rem',
        'important'
      );

      previousButton.style.setProperty(
        'height',
        '3rem',
        'important'
      );

      previousButton.style.setProperty(
        'padding',
        '0',
        'important'
      );

      previousButton.style.setProperty(
        'display',
        'grid',
        'important'
      );

      previousButton.style.setProperty(
        'place-items',
        'center',
        'important'
      );

      previousButton.style.setProperty(
        'border',
        '1px solid var(--color-border-strong)',
        'important'
      );

      previousButton.style.setProperty(
        'border-radius',
        '50%',
        'important'
      );

      previousButton.style.setProperty(
        'color',
        'var(--color-blue-bright)',
        'important'
      );

      previousButton.style.setProperty(
        'background',
        'rgba(7, 14, 24, 0.88)',
        'important'
      );

      previousButton.style.setProperty(
        'box-shadow',
        '0 1rem 3rem rgba(0, 0, 0, 0.5)',
        'important'
      );

      previousButton.style.setProperty(
        'transform',
        'translateY(-50%)',
        'important'
      );

      previousButton.style.setProperty(
        'cursor',
        'pointer',
        'important'
      );

      previousButton.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();

          showDocumentPage(
            activeDocumentIndex - 1
          );
        }
      );

      const nextButton =
        document.createElement(
          'button'
        );

      nextButton.className =
        'document-carousel-control document-carousel-next';

      nextButton.type =
        'button';

      nextButton.setAttribute(
        'aria-label',
        'Show next document page'
      );

      const nextIcon =
        document.createElement(
          'span'
        );

      nextIcon.textContent =
        '→';

      nextIcon.setAttribute(
        'aria-hidden',
        'true'
      );

      nextButton.append(
        nextIcon
      );

      nextButton.style.setProperty(
        'position',
        'absolute',
        'important'
      );

      nextButton.style.setProperty(
        'top',
        '50%',
        'important'
      );

      nextButton.style.setProperty(
        'right',
        '1rem',
        'important'
      );

      nextButton.style.setProperty(
        'z-index',
        '100',
        'important'
      );

      nextButton.style.setProperty(
        'width',
        '3rem',
        'important'
      );

      nextButton.style.setProperty(
        'height',
        '3rem',
        'important'
      );

      nextButton.style.setProperty(
        'padding',
        '0',
        'important'
      );

      nextButton.style.setProperty(
        'display',
        'grid',
        'important'
      );

      nextButton.style.setProperty(
        'place-items',
        'center',
        'important'
      );

      nextButton.style.setProperty(
        'border',
        '1px solid var(--color-border-strong)',
        'important'
      );

      nextButton.style.setProperty(
        'border-radius',
        '50%',
        'important'
      );

      nextButton.style.setProperty(
        'color',
        'var(--color-blue-bright)',
        'important'
      );

      nextButton.style.setProperty(
        'background',
        'rgba(7, 14, 24, 0.88)',
        'important'
      );

      nextButton.style.setProperty(
        'box-shadow',
        '0 1rem 3rem rgba(0, 0, 0, 0.5)',
        'important'
      );

      nextButton.style.setProperty(
        'transform',
        'translateY(-50%)',
        'important'
      );

      nextButton.style.setProperty(
        'cursor',
        'pointer',
        'important'
      );

      nextButton.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();

          showDocumentPage(
            activeDocumentIndex + 1
          );
        }
      );

      page.append(
        previousButton,
        nextButton
      );
    }

    documentGallery.append(page);
  };

  const showDocumentPage = (
    targetIndex
  ) => {
    const documentCount =
      activeDocumentEntries.length;

    if (documentCount === 0) {
      return;
    }

    activeDocumentIndex =
      (
        targetIndex +
        documentCount
      ) %
      documentCount;

    renderActiveDocument();
  };

  const fitAllDocumentImages = () => {
    if (
      !(
        documentDialog instanceof
        HTMLDialogElement
      ) ||
      !documentDialog.open ||
      !(
        documentGallery instanceof
        HTMLElement
      )
    ) {
      return;
    }

    const image =
      documentGallery.querySelector(
        '.document-page img'
      );

    if (
      image instanceof
      HTMLImageElement &&
      image.complete
    ) {
      fitDocumentImage(
        image
      );
    }
  };

  const openDocumentDialog = (
    trigger
  ) => {
    if (
      !(
        trigger instanceof
        HTMLButtonElement
      ) ||
      !(
        documentDialog instanceof
        HTMLDialogElement
      )
    ) {
      return;
    }

    activeDocumentTitle =
      trigger.dataset.documentTitle ??
      'Document preview';

    activeDocumentEntries = [];
    activeDocumentIndex = 0;

    try {
      const parsedEntries =
        JSON.parse(
          trigger.dataset.documentImages ??
            '[]'
        );

      if (Array.isArray(parsedEntries)) {
        activeDocumentEntries =
          parsedEntries.filter(
            (entry) =>
              entry?.type === 'image' &&
              typeof entry.src ===
                'string'
          );
      }
    } catch {
      activeDocumentEntries = [];
    }

    documentDialog.setAttribute(
      'aria-label',
      activeDocumentTitle
    );

    lastDocumentTrigger = trigger;

    documentDialog.showModal();

    document.documentElement.classList.add(
      'has-open-document-dialog'
    );

    renderActiveDocument();
  };


  if (
    documentDialog instanceof
    HTMLDialogElement
  ) {
    documentDialog.addEventListener(
      'keydown',
      (event) => {
        if (
          activeDocumentEntries.length <=
          1
        ) {
          return;
        }

        if (
          event.key ===
          'ArrowLeft'
        ) {
          event.preventDefault();

          showDocumentPage(
            activeDocumentIndex - 1
          );
        }

        if (
          event.key ===
          'ArrowRight'
        ) {
          event.preventDefault();

          showDocumentPage(
            activeDocumentIndex + 1
          );
        }
      }
    );
  }
  documentOpenButtons.forEach(
    (button) => {
      button.addEventListener(
        'click',
        () => {
          openDocumentDialog(button);
        }
      );
    }
  );

  if (
    documentCloseButton instanceof
    HTMLButtonElement
  ) {
    documentCloseButton.addEventListener(
      'click',
      closeDocumentDialog
    );
  }

  if (
    documentDialog instanceof
    HTMLDialogElement
  ) {
    documentDialog.addEventListener(
      'click',
      (event) => {
        if (
          event.target ===
          documentDialog
        ) {
          closeDocumentDialog();
        }
      }
    );

    documentDialog.addEventListener(
      'close',
      () => {
        document.documentElement.classList.remove(
          'has-open-document-dialog'
        );

        documentGallery?.replaceChildren();

        if (
          lastDocumentTrigger instanceof
          HTMLButtonElement
        ) {
          lastDocumentTrigger.focus();
        }
      }
    );
  }

  updateCertificationsHeroMode();
  updateCertificationNavigation();

  window.addEventListener(
    'scroll',
    requestNavigationUpdate,
    {
      passive: true,
    }
  );

  window.addEventListener(
    'resize',
    requestNavigationUpdate
  );

  window.addEventListener(
    'resize',
    () => {
      window.requestAnimationFrame(
        fitAllDocumentImages
      );
    }
  );

  window.addEventListener(
    'load',
    requestNavigationUpdate
  );
  const centeringCertificationCards =
    Array.from(
      document.querySelectorAll(
        '.featured-credential, .program-card, .course-card'
      )
    ).filter(
      (card) =>
        card instanceof HTMLElement
    );

  const certificationCenteringMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const centerCertificationCardAfterClick = (
    event,
    certificationCard
  ) => {
    if (
      !(event.target instanceof Element)
    ) {
      return;
    }

    if (
      event.target.closest(
        'a, button, input, textarea, select, label'
      )
    ) {
      return;
    }

    const selectedText =
      window.getSelection()?.toString();

    if (selectedText) {
      return;
    }

    const position =
      certificationCard.getBoundingClientRect();

    const distanceFromCenter =
      position.top +
      position.height / 2 -
      window.innerHeight / 2;

    if (
      Math.abs(distanceFromCenter) < 40
    ) {
      return;
    }

    certificationCard.scrollIntoView({
      behavior:
        certificationCenteringMotion.matches
          ? 'auto'
          : 'smooth',
      block: 'center',
    });
  };

  centeringCertificationCards.forEach(
    (certificationCard) => {
      certificationCard.addEventListener(
        'click',
        (event) => {
          centerCertificationCardAfterClick(
            event,
            certificationCard
          );
        }
      );
    }
  );
</script>

