      var(--color-text-muted);
    font-family:
      var(--font-mono);
    font-size: 0.61rem;
    line-height: 1.5;
  }

  .course-heading {
    border-bottom: 0;
  }

  .course-groups {
    display: grid;
    gap:
      clamp(2rem, 5vw, 4.25rem);
  }

  .course-group {
    padding-top:
      clamp(1.75rem, 3vw, 2.5rem);
    display: grid;
    grid-template-columns:
      minmax(13rem, 0.85fr)
      minmax(0, 3.15fr);
    align-items: start;
    gap:
      clamp(2rem, 5vw, 5rem);
    border-top: 1px solid
      var(--color-border);
  }

  .course-group-header {
    position: static;
    display: grid;
    grid-template-columns:
      auto
      minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }

  .course-group-number {
    color:
      rgba(125, 211, 252, 0.22);
    font-family:
      var(--font-mono);
    font-size:
      clamp(2.8rem, 5vw, 4.75rem);
    font-weight: 650;
    line-height: 0.85;
    letter-spacing: -0.08em;
  }

  .course-group-header h3 {
    margin: 0;
    font-size:
      clamp(1.3rem, 2vw, 1.9rem);
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  .course-group-header p {
    margin: 0.85rem 0 0;
    color:
      var(--color-text-secondary);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .course-list {
    display: grid;
    gap: 0.85rem;
  }

  .course-card {
    position: relative;
    min-width: 0;
    padding:
      clamp(1.15rem, 1.8vw, 1.5rem);
    display: grid;
    grid-template-columns:
      auto
      minmax(0, 1fr)
      auto;
    align-items: center;
    gap:
      clamp(1rem, 2vw, 1.5rem);
    overflow: hidden;
    border: 1px solid
      var(--color-border);
    border-radius:
      var(--radius-medium);
    background:
      linear-gradient(
        145deg,
        rgba(16, 24, 36, 0.86),
        rgba(8, 12, 18, 0.76)
      );
    animation:
      reveal-credential
      680ms
      cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
    animation-delay:
      var(--reveal-delay);
    transition:
      border-color
        var(--transition-standard),
      box-shadow
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .course-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 0.18rem;
    height: 100%;
    content: "";
    background:
      linear-gradient(
        to bottom,
        transparent,
        var(--color-blue-light),
        transparent
      );
    opacity: 0.4;
    transition:
      width
        var(--transition-standard),
      opacity
        var(--transition-standard);
  }

  .course-card:hover,
  .course-card:focus-within {
    border-color:
      var(--color-border-strong);
    box-shadow:
      0 22px 65px
        rgba(0, 0, 0, 0.34),
      0 0 2.5rem
        rgba(37, 99, 235, 0.1);
    transform:
      translateX(0.35rem);
  }

  .course-card:hover::before,
  .course-card:focus-within::before {
    width: 0.28rem;
    opacity: 1;
  }

  .course-mark {
    position: relative;
    z-index: 1;
    width:
      clamp(3.25rem, 4.5vw, 4.25rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 1px solid
      var(--color-border-strong);
    border-radius: 50%;
    color:
      var(--color-blue-bright);
    background:
      linear-gradient(
        145deg,
        rgba(22, 33, 49, 0.94),
        rgba(7, 9, 13, 0.88)
      );
    font-family:
      var(--font-mono);
    font-size:
      clamp(0.67rem, 0.85vw, 0.82rem);
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .course-content {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .course-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    color:
      var(--color-text-muted);
    font-family:
      var(--font-mono);
    font-size: 0.57rem;
    letter-spacing: 0.065em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .course-content h4 {
    margin: 0.65rem 0 0;
    font-size:
      clamp(1rem, 1.45vw, 1.28rem);
    font-weight: 580;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .course-provider {
    margin: 0.55rem 0 0;
    color:
      var(--color-text-secondary);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .course-details {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    color:
      var(--color-text-muted);
    font-family:
      var(--font-mono);
    font-size: 0.56rem;
    line-height: 1.45;
  }

  .document-dialog {
    width: min(96vw, 86rem);
    max-height: 96vh;
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 0;
    color:
      var(--color-text);
    background: transparent;
    box-shadow: none;
  }

  .document-dialog::backdrop {
    background:
      rgba(8, 35, 72, 0.84);
    -webkit-backdrop-filter:
      blur(0.8rem);
    backdrop-filter:
      blur(0.8rem);
  }

  .document-dialog-close {
    position: fixed;
    top:
      clamp(1rem, 2vw, 2rem);
    right:
      clamp(1rem, 2vw, 2rem);
    z-index: 3;
    width:
      clamp(2.75rem, 4vw, 3.4rem);
    height:
      clamp(2.75rem, 4vw, 3.4rem);
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid
      var(--color-blue-bright);
    border-radius: 50%;
    color: #ffffff;
    background:
      rgba(37, 99, 235, 0.72);
    box-shadow:
      0 1rem 3rem
        rgba(0, 0, 0, 0.44),
      0 0 2.5rem
        rgba(96, 165, 250, 0.34);
    -webkit-backdrop-filter:
      blur(1rem);
    backdrop-filter:
      blur(1rem);
    font-size:
      clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1;
    cursor: pointer;
    transition:
      background-color
        var(--transition-fast),
      border-color
        var(--transition-fast),
      box-shadow
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .document-dialog-close:hover,
  .document-dialog-close:focus-visible {
    border-color: #ffffff;
    background:
      rgba(59, 130, 246, 0.94);
    box-shadow:
      0 1.2rem 3.5rem
        rgba(0, 0, 0, 0.5),
      0 0 3rem
        rgba(125, 211, 252, 0.5);
    transform:
      rotate(5deg)
      scale(1.06);
  }

  .document-gallery {
    width: 100%;
    min-height: 80vh;
    padding:
      clamp(1rem, 3vw, 3rem);
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    justify-items: center;
    gap:
      clamp(1.5rem, 4vw, 3rem);
  }

  .document-page {
    width: 100%;
    display: grid;
    place-items: center;
  }

  .document-page img {
    width: auto;
    max-width: 100%;
    max-height: 90vh;
    display: block;
    object-fit: contain;
    border-radius:
      var(--radius-small);
    background: #ffffff;
    box-shadow:
      0 2.5rem 7rem
        rgba(0, 0, 0, 0.52);
  }

  .document-pdf {
    width: 100%;
    height:
      min(88vh, 62rem);
    display: block;
    border: 0;
    border-radius:
      var(--radius-small);
    background: #ffffff;
    box-shadow:
      0 2.5rem 7rem
        rgba(0, 0, 0, 0.52);
  }

  .certification-navigation {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 40;
    box-sizing: border-box;
    width: 10vw;
    padding-inline:
      clamp(
        0.35rem,
        0.8vw,
        0.85rem
      );
    display: flex;
    align-items: center;
    flex-direction: column;
    gap:
      clamp(0.45rem, 0.8vw, 0.7rem);
    visibility: visible;
    opacity: 1;
    transform:
      translateY(-50%)
      scale(1);
    transition:
      visibility
        var(--transition-standard),
      opacity
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .certification-navigation.is-hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform:
      translateY(-50%)
      translateX(0.8rem)
      scale(0.95);
  }

  .certification-navigation-label {
    box-sizing: border-box;
    width: 100%;
    max-width: 7.5rem;
    min-height:
      clamp(
        3rem,
        4vw,
        4rem
      );
    padding:
      clamp(
        0.6rem,
        0.7vw,
        0.8rem
      )
      clamp(
        0.35rem,
        0.5vw,
        0.55rem
      );
    display: grid;
    place-items: center;
    border: 1px solid
      var(--color-border-strong);
    border-radius: 999px;
    color:
      var(--color-text-secondary);
    background:
      linear-gradient(
        145deg,
        rgba(18, 27, 40, 0.97),
        rgba(7, 9, 13, 0.95)
      );
    box-shadow:
      0 1.2rem 3.5rem
        rgba(0, 0, 0, 0.42),
      0 0 2rem
        rgba(37, 99, 235, 0.12);
    font-family:
      var(--font-mono);
    font-size:
      clamp(
        0.46rem,
        0.55vw,
        0.64rem
      );
    font-weight: 570;
    letter-spacing: 0.055em;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
  }

  .certification-navigation-button {
    width:
      clamp(
        2.6rem,
        3.2vw,
        3.5rem
      );
    height:
      clamp(
        2.6rem,
        3.2vw,
        3.5rem
      );
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid
      var(--color-border-strong);
    border-radius: 50%;
    color:
      var(--color-blue-bright);
    background:
      linear-gradient(
        145deg,
        rgba(18, 27, 40, 0.98),
        rgba(7, 9, 13, 0.96)
      );
    box-shadow:
      0 1rem 3rem
        rgba(0, 0, 0, 0.42),
      0 0 2rem
        rgba(37, 99, 235, 0.14);
    font: inherit;
    font-size:
      clamp(
        0.95rem,
        1vw,
        1.15rem
      );
    cursor: pointer;
    transition:
      color
        var(--transition-fast),
      border-color
        var(--transition-fast),
      box-shadow
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .certification-navigation-button:hover,
  .certification-navigation-button:focus-visible {
    color: #ffffff;
    border-color:
      var(--color-blue-bright);
    box-shadow:
      0 1.2rem 3.5rem
        rgba(0, 0, 0, 0.46),
      0 0 2.4rem
        rgba(59, 130, 246, 0.28);
    transform: scale(1.06);
  }

  .certification-navigation-button.is-unavailable {
    display: none;
  }

  .certification-navigation.is-narrow {
    padding-inline:
      clamp(
        0.65rem,
        1.15vw,
        1rem
      );
    gap: 0.4rem;
  }

  .certification-navigation.is-narrow
    .certification-navigation-label {
    max-width: 5.25rem;
    min-height: 3rem;
    padding:
      0.55rem
      0.34rem;
    font-size: 0.48rem;
  }

  .certification-navigation.is-narrow
    .certification-navigation-button {
    width: 2.45rem;
    height: 2.45rem;
    font-size: 0.9rem;
  }

  .certification-navigation.is-compact {
    gap: 0.45rem;
  }

  .certification-navigation.is-compact
    .certification-navigation-label {
    display: none;
  }

  .certification-navigation.is-compact
    .certification-navigation-button {
    width:
      clamp(
        2.1rem,
        4vw,
        2.75rem
      );
    height:
      clamp(
        2.1rem,
        4vw,
        2.75rem
      );
    font-size:
      clamp(
        0.85rem,
        1vw,
        1rem
      );
  }

  @keyframes reveal-credential {
    from {
      opacity: 0;
      transform:
        translateY(2rem)
        scale(0.988);
    }

    to {
      opacity: 1;
      transform:
        translateY(0)
        scale(1);
    }
  }

  @media (max-width: 1180px) {
    .credential-stage {
      grid-template-columns: 1fr;
    }

    .archive-index {
      display: grid;
      grid-template-columns:
        auto
        minmax(0, 1fr);
      align-items: center;
      gap: 2rem;
    }

    .archive-stats {
      margin: 0;
      display: grid;
      grid-template-columns:
        repeat(3, minmax(0, 1fr));
    }

    .archive-stats div,
    .archive-stats div:last-child {
      padding:
        0
        clamp(1rem, 3vw, 2rem);
      border-top: 0;
      border-right: 1px solid
        var(--color-border);
      border-bottom: 0;
    }

    .archive-stats div:first-child {
      padding-left: 0;
    }

    .archive-stats div:last-child {
      padding-right: 0;
      border-right: 0;
    }
  }

  @media (max-width: 980px) {
    .program-grid {
      grid-template-columns: 1fr;
    }

    .program-card {
      min-height: 0;
    }

    .course-group {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .course-group-header {
      max-width: 720px;
    }
  }

  @media (max-width: 820px) {

    .section-heading > p {
      max-width: 680px;
    }

    .credential-main {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .credential-seal,
    .credential-copy h2 {
      margin-inline: auto;
    }

    .credential-description {
      margin-inline: auto;
    }

    .credential-footer {
      grid-template-columns: 1fr;
    }

    .credential-footer div {
      padding:
        0.75rem
        0;
      border-bottom: 1px solid
        var(--color-border);
    }

    .credential-footer div:last-of-type {
      border-bottom: 0;
    }

    .credential-footer
      .document-button {
      justify-self: end;
    }

    .course-card {
      grid-template-columns:
        auto
        minmax(0, 1fr);
    }

    .course-link {
      grid-column:
        1 / -1;
      justify-self: end;
    }
  }

  @media (max-width: 760px) {
    :global(.page-content) {
      --certifications-section-spacing:
        clamp(3rem, 10vw, 4.5rem);
    }

    .certifications-hero {
      width: 80vw;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      text-align: center;
    }

    .certifications-hero h1,
    .certifications-lead {
      margin-inline: auto;
    }

    .certifications-hero h1 {
      font-size:
        clamp(2.8rem, 11vw, 4rem);
    }

    .certifications-lead {
      max-width: 680px;
    }

    .archive-index {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .archive-stats {
      grid-template-columns: 1fr;
    }

    .archive-stats div,
    .archive-stats div:first-child,
    .archive-stats div:last-child {
      padding:
        1rem
        0;
      border-right: 0;
      border-bottom: 0;
      border-top: 1px solid
        var(--color-border);
    }
  }

  @media (max-width: 600px) {
    .credential-header {
      flex-direction: column;
      gap: 1rem;
    }

    .credential-reference {
      text-align: left;
    }

    .featured-credential {
      padding:
        1.25rem
        1rem;
    }

    .credential-footer
      .document-button {
      width: 100%;
      justify-self: stretch;
    }

    .program-card {
      grid-template-columns: 1fr;
    }

    .program-mark {
      width: 100%;
      height: 4.5rem;
      min-height: 0;
      padding:
        0.75rem
        1rem;
      align-items: center;
      flex-direction: row;
    }

    .program-mark span {
      margin: 0;
      writing-mode: initial;
      transform: none;
    }

    .program-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .program-footer {
      align-items: stretch;
      flex-direction: column;
    }

    .program-footer
      .document-button {
      width: 100%;
    }

    .course-group-header {
      grid-template-columns: 1fr;
    }

    .course-card {
      grid-template-columns: 1fr;
    }

    .course-mark {
      width: 3.5rem;
    }

    .course-link {
      grid-column: auto;
      justify-self: stretch;
      width: 100%;
    }

    .course-details span:last-child {
      overflow-wrap: anywhere;
    }

    .document-dialog {
      width: 100vw;
      max-height: 100vh;
    }

    .document-gallery {
      min-height: 100vh;
      padding:
        4.5rem
        0.75rem
        1rem;
    }

    .document-pdf {
      height: 82vh;
    }
  }

  @media (max-width: 720px) {
    .certification-navigation {
      right: 0.65rem;
      width: auto;
      padding-inline: 0;
      gap: 0.45rem;
    }

    .certification-navigation-label {
      display: none;
    }
  }

  @media (
    (hover: none) and
    (pointer: coarse)
  ) {
    .featured-credential,
    .program-card,
    .course-card {
      -webkit-tap-highlight-color:
        transparent;
    }

    .featured-credential::after,
    .program-card::after,
    .course-card::after {
      display: none;
    }
  }
  :global(.page-content) {
    --card-navigation-button-size:
      2.125rem;
    --card-navigation-gutter:
      max(
        11vw,
        2.25rem
      );
    --card-navigation-content-width:
      calc(
        100vw -
        var(--card-navigation-gutter) -
        var(--card-navigation-gutter)
      );
  }

  .certification-navigation-button,
  .certification-navigation.is-narrow
    .certification-navigation-button,
  .certification-navigation.is-compact
    .certification-navigation-button {
    box-sizing: border-box;
    width:
      var(--card-navigation-button-size);
    height:
      var(--card-navigation-button-size);
    font-size: 0.78rem;
  }

  @media (max-width: 760px) {
    .certification-navigation,
    .certification-navigation.is-narrow,
    .certification-navigation.is-compact {
      right: 0;
      width:
        var(--card-navigation-gutter);
      padding-inline: 0;
      align-items: center;
      gap: 0.45rem;
    }

    .certification-navigation-label,
    .certification-navigation.is-narrow
      .certification-navigation-label,
    .certification-navigation.is-compact
      .certification-navigation-label {
      display: none;
    }

    .credential-stage,
    .programs-section,
    .course-archive {
      width:
        var(--card-navigation-content-width);
      transform:
        translateX(-50%);
    }
  }
  @media (
    prefers-reduced-motion:
    reduce
  ) {
    .featured-credential,
    .program-card,
    .course-card {
      animation: none;
    }

    .featured-credential,
    .featured-credential::before,
    .featured-credential::after,
    .credential-seal,
    .program-card,
    .program-card::before,
    .course-card,
    .course-card::before,
    .document-button,
    .course-link,
    .document-dialog-close,
    .certification-navigation,
    .certification-navigation-button {
      transition: none;
    }
  }

  .document-dialog[data-document-dialog] {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width:
      min(
        calc(100vw - 3rem),
        48rem
      );
    max-width: 48rem;
    max-height:
      min(
        calc(100vh - 3rem),
        34rem
      );
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid
      var(--color-border-strong);
    border-radius:
      var(--radius-large);
    color:
      var(--color-text);
    background:
      linear-gradient(
        145deg,
        rgba(16, 27, 43, 0.94),
        rgba(6, 12, 21, 0.9)
      );
    box-shadow:
      0 3rem 8rem
        rgba(0, 0, 0, 0.68),
      0 0 4rem
        rgba(37, 99, 235, 0.2);
    -webkit-backdrop-filter:
      blur(1rem);
    backdrop-filter:
      blur(1rem);
  }

  .document-dialog[data-document-dialog]::backdrop {
    background:
      rgba(3, 9, 18, 0.68);
    -webkit-backdrop-filter:
      blur(0.75rem);
    backdrop-filter:
      blur(0.75rem);
  }

  .document-dialog[data-document-dialog]
    .document-dialog-close {
    position: absolute;
    top:
      clamp(
        0.85rem,
        2vw,
        1.25rem
      );
    right:
      clamp(
        0.85rem,
        2vw,
        1.25rem
      );
    z-index: 4;
    width:
      clamp(
        2.55rem,
        4vw,
        3rem
      );
    height:
      clamp(
        2.55rem,
        4vw,
        3rem
      );
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid
      var(--color-border-strong);
    border-radius: 50%;
    color:
      var(--color-blue-bright);
    background:
      linear-gradient(
        145deg,
        rgba(18, 27, 40, 0.82),
        rgba(7, 9, 13, 0.76)
      );
