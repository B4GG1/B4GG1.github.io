---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getContactTranslations,
} from '../i18n/contact';
import {
  getLocaleFromPath,
} from '../i18n/helpers';

const locale =
  getLocaleFromPath(Astro.url.pathname);

const t =
  getContactTranslations(locale);

const githubUrl =
  'https://github.com/B4GG1';

const mapEmbedUrl =
  'https://www.google.com/maps?q=Katowice%2C%20Poland&z=13&output=embed';
---

<BaseLayout
  title={t.metadata.title}
  description={t.metadata.description}
  lang={locale}
>
  <section
    class="contact-hero"
    aria-labelledby="contact-title"
    data-contact-hero
  >
    <h1 id="contact-title">
      {t.hero.title}
    </h1>

    <p class="contact-lead">
      {t.hero.lead}
    </p>
  </section>

  <section
    class="contact-layout"
    aria-label={t.layoutAria}
  >
    <article class="contact-form-card">
      <header class="contact-card-heading">
        <h2 class="contact-card-title">
          {t.form.title}
        </h2>
      </header>

      <form
        class="contact-form"
        action="https://formspree.io/f/xoeaevzv"
        method="POST"
        data-contact-form
        data-sending-message={t.form.sending}
        data-success-message={t.form.success}
        data-error-message={t.form.error}
      >
        <div class="form-stack">
          <label class="form-field">
            <span>{t.form.name} <span class="required-marker" aria-hidden="true">*</span></span>

            <input
              type="text"
              name="name"
              autocomplete="name"
              maxlength="100"
              placeholder={t.form.namePlaceholder}
              required
              data-required-field
            />
          </label>

          <label class="form-field">
            <span>{t.form.email} <span class="required-marker" aria-hidden="true">*</span></span>

            <input
              type="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              maxlength="160"
              placeholder={t.form.emailPlaceholder}
              required
              data-required-field
            />
          </label>

          <label class="form-field">
            <span>{t.form.subject} <span class="required-marker" aria-hidden="true">*</span></span>

            <input
              type="text"
              name="subject"
              maxlength="160"
              placeholder={t.form.subjectPlaceholder}
              required
              data-required-field
            />
          </label>

          <label class="form-field form-field-message">
            <span>{t.form.message} <span class="required-marker" aria-hidden="true">*</span></span>

            <textarea
              name="message"
              rows="10"
              maxlength="3000"
              placeholder={t.form.messagePlaceholder}
              required
              data-required-field
            ></textarea>
          </label>
        </div>

        <div class="form-footer">
          <button
            class="submit-button"
            type="submit"
            disabled
            aria-disabled="true"
            data-submit-button
          >
            <span>{t.form.submit}</span>

            <span aria-hidden="true">
              →
            </span>
          </button>
        </div>

        <p
          class="form-status"
          role="status"
          aria-live="polite"
          data-form-status
        ></p>

        <p class="required-note"><span class="required-marker" aria-hidden="true">*</span> {t.form.requiredFields}</p>
      </form>
    </article>

    <aside class="contact-sidebar">
      <article class="contact-card direct-contact-card">
        <header class="contact-card-heading">
          <h2 class="contact-card-title">
            {t.direct.title}
          </h2>
        </header>

        <ul class="contact-details">
          <li class="contact-detail">
            <span
              class="contact-detail-icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24">
                <path d="M4 6h16v12H4z"></path>

                <path d="m4 7 8 6 8-6"></path>
              </svg>
            </span>

            <div>
              <span class="contact-detail-label">
                {t.direct.email}
              </span>

              <a
                class="contact-email"
                href="mailto:bartosz.girzecki@gmail.com"
              >
                bartosz.girzecki@gmail.com
              </a>
            </div>
          </li>

          <li class="contact-detail">
            <span
              class="contact-detail-icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24">
                <path
                  d="M7.2 3.8 10 7.7 8.3 10a14.8 14.8 0 0 0 5.7 5.7l2.3-1.7 3.9 2.8-.7 3.1c-.2.8-.9 1.3-1.7 1.3C9.6 20.6 3.4 14.4 2.8 6.2c0-.8.5-1.5 1.3-1.7z"
                ></path>
              </svg>
            </span>

            <div class="phone-detail-copy">
              <span class="contact-detail-label">
                {t.direct.phone}
              </span>

              <strong>
                +48 787 ••• •••
              </strong>

              <small>
                {t.direct.phoneNote}
              </small>
            </div>
          </li>

          <li class="contact-detail">
            <span
              class="contact-detail-icon"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24">
                <path
                  d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z"
                ></path>

                <circle
                  cx="12"
                  cy="9"
                  r="2.4"
                ></circle>
              </svg>
            </span>

            <div>
              <span class="contact-detail-label">
                {t.direct.location}
              </span>

              <strong>
                {t.direct.locationValue}
              </strong>
            </div>
          </li>
        </ul>

        <div class="map-frame">
          <iframe
            class="map-embed"
            title={t.direct.mapTitle}
            src={mapEmbedUrl}
            loading="lazy"
            referrerpolicy="no-referrer"
            allowfullscreen
          ></iframe>

          <span
            class="map-radar"
            aria-hidden="true"
          >
            <span></span>
          </span>
        </div>
      </article>

      <article class="contact-card resources-card">
        <header class="contact-card-heading">
          <h2 class="contact-card-title">
            {t.resources.title}
          </h2>
        </header>

        <div class="resources-content">
          <div
            class="cv-downloads"
            aria-label={t.resources.cvAria}
          >
            <a class="resource-button" href="/assets/cv/Bartosz_Girzecki_CV_PL_Public.pdf" download><svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M12 3v12"></path>

                <path d="m7 10 5 5 5-5"></path>

                <path d="M5 20h14"></path>
              </svg>

              <span>
                <strong>{t.resources.cvPolish}</strong>
                <small>{t.resources.downloadPdf}</small>
              </span></a>

            <a class="resource-button" href="/assets/cv/Bartosz_Girzecki_CV_ENG_Public.pdf" download><svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M12 3v12"></path>

                <path d="m7 10 5 5 5-5"></path>

                <path d="M5 20h14"></path>
              </svg>

              <span>
                <strong>{t.resources.cvEnglish}</strong>
                <small>{t.resources.downloadPdf}</small>
              </span></a>
          </div>

          <div
            class="profile-links"
            aria-label={t.resources.profilesAria}
          >
            <a
              class="profile-link"
              href={githubUrl}
              target="_blank"
              rel="noreferrer"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M12 2.8a9.4 9.4 0 0 0-3 18.3c.5.1.7-.2.7-.5v-1.8c-2.8.6-3.4-1.2-3.4-1.2-.5-1.1-1.1-1.4-1.1-1.4-.9-.6.1-.6.1-.6 1 0 1.5 1 1.5 1 .9 1.5 2.3 1.1 2.9.8.1-.6.3-1.1.6-1.3-2.2-.3-4.6-1.1-4.6-4.9 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.3 9.3 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.8-2.3 4.6-4.6 4.9.4.3.7.9.7 1.8v2.7c0 .3.2.6.7.5A9.4 9.4 0 0 0 12 2.8Z"
                ></path>
              </svg>

              <span>
                <strong>GitHub</strong>
                <small>B4GG1</small>
              </span>


            </a>

            <a
              class="profile-link"
              href="https://www.linkedin.com/in/bartosz-girzecki-047929214/"
              target="_blank"
              rel="noreferrer"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <rect
                  x="4"
                  y="9"
                  width="4"
                  height="11"
                ></rect>

                <circle
                  cx="6"
                  cy="5.5"
                  r="2"
                ></circle>

                <path
                  d="M12 20V9h4v1.7c.8-1.2 2-2 3.8-2 3 0 4.2 2 4.2 5.4V20h-4v-5.2c0-1.5-.5-2.5-1.8-2.5-1.4 0-2.2 1-2.2 2.8V20Z"
                ></path>
              </svg>

              <span>
                <strong>LinkedIn</strong>
                <small>Bartosz Girzecki</small>
              </span>
            </a>
          </div>
        </div>
      </article>
    </aside>
  </section>
</BaseLayout>

<script>
  const contactHero =
    document.querySelector(
      '[data-contact-hero]'
    );

  const contactForm =
    document.querySelector(
      '[data-contact-form]'
    );

  const submitButton =
    document.querySelector(
      '[data-submit-button]'
    );

  const formStatus =
    document.querySelector(
      '[data-form-status]'
    );

  const requiredFields =
    Array.from(
      document.querySelectorAll(
        '[data-required-field]'
      )
    );

  const compactHeroRatio = 0.6;

  const updateContactHeroMode = () => {
    if (
      !(
        contactHero instanceof
        HTMLElement
      )
    ) {
      return;
    }

    const availableScreenWidth =
      window.screen.availWidth ||
      window.screen.width ||
      window.innerWidth;

    contactHero.classList.toggle(
      'is-stacked',
      window.innerWidth <=
        availableScreenWidth *
          compactHeroRatio
    );
  };

  const formIsComplete = () => {
    return requiredFields.every(
      (field) => {
        if (
          !(
            field instanceof
              HTMLInputElement ||
            field instanceof
              HTMLTextAreaElement
          )
        ) {
          return false;
        }

        return (
          field.value.trim().length > 0 &&
          field.checkValidity()
        );
      }
    );
  };

  const updateSubmitButton = () => {
    if (
      !(
        submitButton instanceof
        HTMLButtonElement
      )
    ) {
      return;
    }

    const isComplete =
      formIsComplete();

    submitButton.disabled =
      !isComplete;

    submitButton.setAttribute(
      'aria-disabled',
      String(!isComplete)
    );

    if (
      formStatus instanceof
        HTMLElement &&
      formStatus.textContent
    ) {
      formStatus.textContent = '';
    }
  };

  requiredFields.forEach(
    (field) => {
      field.addEventListener(
        'input',
        updateSubmitButton
      );

      field.addEventListener(
        'change',
        updateSubmitButton
      );
    }
  );

  if (
    contactForm instanceof
      HTMLFormElement
  ) {
    contactForm.addEventListener(
      'submit',
      async (event) => {
        event.preventDefault();

        updateSubmitButton();

        if (
          !formIsComplete() ||
          contactForm.dataset.submitting ===
            'true'
        ) {
          return;
        }

        contactForm.dataset.submitting =
          'true';

        if (
          submitButton instanceof
            HTMLButtonElement
        ) {
          submitButton.disabled = true;
          submitButton.setAttribute(
            'aria-disabled',
            'true'
          );
        }

        if (
          formStatus instanceof
            HTMLElement
        ) {
          formStatus.textContent =
            contactForm.dataset.sendingMessage ??
            'Sending message...';
        }

        try {
          const response =
            await fetch(
              contactForm.action,
              {
                method: 'POST',
                body:
                  new FormData(
                    contactForm
                  ),
                headers: {
                  Accept:
                    'application/json',
                },
              }
            );

          if (!response.ok) {
            throw new Error(
              'Message could not be sent.'
            );
          }

          contactForm.reset();

          if (
            formStatus instanceof
              HTMLElement
          ) {
            formStatus.textContent =
              contactForm.dataset.successMessage ??
              'Message sent successfully. Thank you — I will get back to you soon.';

            window.alert(
              contactForm.dataset.successMessage ??
                'Message sent successfully. Thank you — I will get back to you soon.'
            );
          }

          if (
            submitButton instanceof
              HTMLButtonElement
          ) {
            submitButton.disabled = true;
            submitButton.setAttribute(
              'aria-disabled',
              'true'
            );
          }
        } catch {
          if (
            formStatus instanceof
              HTMLElement
          ) {
            formStatus.textContent =
              contactForm.dataset.errorMessage ??
              'Message could not be sent. Please try again or contact me directly by email.';
          }

          if (
            submitButton instanceof
              HTMLButtonElement
          ) {
            submitButton.disabled =
              !formIsComplete();

            submitButton.setAttribute(
              'aria-disabled',
              String(
                !formIsComplete()
              )
            );
          }
        } finally {
          delete contactForm.dataset.submitting;
        }
      }
    );
  }

  updateContactHeroMode();
  updateSubmitButton();

  window.addEventListener(
    'resize',
    updateContactHeroMode
  );

  window.addEventListener(
    'load',
    updateContactHeroMode
  );
</script>

<style>
  :global(.page-content) {
    --contact-section-spacing:
      clamp(4rem, 7vw, 6.5rem);

    padding-top:
      var(--contact-section-spacing);
    padding-bottom:
      clamp(6rem, 11vw, 10rem);
  }

  .contact-hero {
    position: relative;
    left: 50%;
    width: 70vw;
    margin: 0;
    display: grid;
    grid-template-columns:
      max-content
      minmax(0, 1fr);
    align-items: center;
    gap:
      clamp(4rem, 6vw, 7rem);
    transform:
      translateX(-50%);
  }

  .contact-hero h1 {
    width: fit-content;
    margin: 0;
    padding:
      0.08em
      0.16em
      0.22em
      0.04em;
    justify-self: center;
    display: inline-block;
    overflow: visible;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        #dbeafe 38%,
        var(--color-blue-light) 74%,
        var(--color-blue-bright) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color:
      transparent;
    font-size:
      clamp(3rem, 4.4vw, 5.5rem);
    line-height: 1.12;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }

  .contact-lead {
    width: 100%;
    max-width: 760px;
    margin: 0;
    justify-self: center;
    color:
      var(--color-text-secondary);
    font-size:
      clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.7;
  }

  .contact-hero.is-stacked {
    width: 80vw;
    grid-template-columns: 1fr;
    gap:
      clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
  }

  .contact-hero.is-stacked h1,
  .contact-hero.is-stacked
    .contact-lead {
    margin-inline: auto;
  }

  .contact-layout {
    position: relative;
    left: 50%;
    width: 80vw;
    margin-top:
      var(--contact-section-spacing);
    display: grid;
    grid-template-columns:
      minmax(0, 1.45fr)
      minmax(20rem, 0.75fr);
    align-items: stretch;
    gap:
      clamp(1rem, 2vw, 1.75rem);
    transform:
      translateX(-50%);
  }

  .contact-form-card,
  .contact-card {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border: 1px solid
      var(--color-border);
    border-radius:
      var(--radius-large);
    background:
      linear-gradient(
        145deg,
        rgba(18, 27, 40, 0.88),
        rgba(8, 13, 20, 0.8)
      );
    box-shadow:
      var(--shadow-card);
    transition:
      border-color
        var(--transition-standard),
      box-shadow
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .contact-form-card::before,
  .contact-card::before {
    position: absolute;
    right: -9rem;
    bottom: -9rem;
    width: 20rem;
    height: 20rem;
    content: "";
    pointer-events: none;
    border-radius: 50%;
    background:
      rgba(37, 99, 235, 0.15);
    filter:
      blur(4rem);
    opacity: 0.18;
    transition:
      opacity
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .contact-form-card:hover,
  .contact-form-card:focus-within,
  .contact-card:hover,
  .contact-card:focus-within {
    border-color:
      var(--color-border-strong);
    box-shadow:
      0 34px 100px
        rgba(0, 0, 0, 0.42),
      0 0 3.5rem
        rgba(37, 99, 235, 0.13);
    transform:
      translateY(-0.3rem);
  }

  .contact-form-card:hover::before,
  .contact-form-card:focus-within::before,
  .contact-card:hover::before,
  .contact-card:focus-within::before {
    opacity: 0.65;
    transform:
      scale(1.15);
  }

  .contact-form-card {
    height: 100%;
    padding:
      clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
  }

  .contact-card {
    height: 100%;
    padding:
      clamp(1.35rem, 2.3vw, 2rem);
    display: flex;
    flex-direction: column;
  }

  .contact-card-heading,
  .contact-form,
  .contact-details,
  .map-frame,
  .resources-content {
    position: relative;
    z-index: 1;
  }

  .contact-card-title {
    width: fit-content;
    margin: 0;
    color:
      var(--color-text);
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        #dbeafe 42%,
        var(--color-blue-light) 76%,
        var(--color-blue-bright) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color:
      var(--color-text);
    font-size:
      clamp(1.65rem, 2.7vw, 2.65rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.05em;
    transition:
      -webkit-text-fill-color
        var(--transition-standard);
  }

  .contact-form-card:hover
    .contact-card-title,
  .contact-form-card:focus-within
    .contact-card-title,
  .contact-card:hover
    .contact-card-title,
  .contact-card:focus-within
    .contact-card-title {
    -webkit-text-fill-color:
      transparent;
  }

  .contact-form {
    min-height: 0;
    margin-top:
      clamp(2rem, 4vw, 3rem);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .form-stack {
    min-height: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap:
      clamp(1rem, 2vw, 1.35rem);
  }

  .form-field {
    min-width: 0;
    display: grid;
    gap: 0.65rem;
  }

  .form-field-message {
    min-height: 15rem;
    flex: 1;
    grid-template-rows:
      auto
      minmax(15rem, 1fr);
  }

  .form-field > span {
    color:
      var(--color-text-secondary);
    font-family:
      var(--font-mono);
    font-size: 0.64rem;
    font-weight: 560;
    letter-spacing: 0.055em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    min-width: 0;
    border: 1px solid
      var(--color-border);
    border-radius:
      var(--radius-small);
    outline: 0;
    color:
      var(--color-text);
    background:
      rgba(7, 10, 16, 0.62);
    box-shadow:
      inset 0 1px 0
        rgba(255, 255, 255, 0.025);
    font: inherit;
    font-size: 0.92rem;
    line-height: 1.55;
    transition:
      border-color
        var(--transition-fast),
      background-color
        var(--transition-fast),
      box-shadow
        var(--transition-standard);
  }

  .form-field input {
    min-height: 3.25rem;
    padding:
      0.8rem
      0.95rem;
  }

  .form-field textarea {
    min-height: 15rem;
    padding:
      0.95rem;
    resize: vertical;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color:
      var(--color-text-muted);
    opacity: 0.8;
  }

  .form-field input:hover,
  .form-field textarea:hover {
    border-color:
      rgba(96, 165, 250, 0.28);
  }

  .form-field input:focus,
  .form-field textarea:focus {
    border-color:
      var(--color-blue-light);
    background:
      rgba(10, 16, 25, 0.82);
    box-shadow:
      0 0 0 0.2rem
        rgba(59, 130, 246, 0.11),
      0 0 2rem
        rgba(37, 99, 235, 0.1);
  }

  .form-footer {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid
      var(--color-border);
  }

  .submit-button {
    min-height: 2.75rem;
    padding:
      0.75rem
      0.9rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid
      var(--color-border-strong);
    border-radius:
      var(--radius-small);
    color:
      var(--color-text);
    background:
      linear-gradient(
        135deg,
        rgba(37, 99, 235, 0.18),
        rgba(10, 15, 23, 0.88)
      );
    box-shadow:
      0 0.8rem 2.5rem
        rgba(0, 0, 0, 0.2);
    font-family:
      var(--font-mono);
    font-size: 0.65rem;
    font-weight: 570;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color
        var(--transition-fast),
      border-color
        var(--transition-fast),
      box-shadow
        var(--transition-standard),
      background-color
        var(--transition-fast),
      gap
        var(--transition-standard),
      transform
        var(--transition-standard),
      opacity
