---

<BaseLayout
  title="Skills"
  description="Technical capabilities of Bartosz Girzecki across software quality, test automation, programming, backend development, delivery and game development."
>
  <section
    class="skills-hero"
    aria-labelledby="skills-title"
    data-skills-hero
  >
    <h1 id="skills-title">
      Skills
    </h1>

    <p class="skills-lead">
      Professional software quality experience combined with active
      development in test automation, programming, backend development
      and a long-term creative direction in game development.
    </p>
  </section>

  <section
    class="skills-grid"
    aria-label="Technical skill categories"
  >
    {
      skillColumns.map((column, index) => (
        <article
          class="skill-column"
          style={`--reveal-delay: ${100 + index * 140}ms;`}
          data-skill-card
        >
          <header class="column-header">

            <h2>{column.title}</h2>

            <p class="column-description">
              {column.description}
            </p>
          </header>

          <div class="skill-groups">
            {
              column.groups.map((group) => (
                <section class="skill-group">
                  <h3>{group.title}</h3>

                  <ul>
                    {
                      group.skills.map((skill) => (
                        <li>{skill}</li>
                      ))
                    }
                  </ul>
                </section>
              ))
            }
          </div>
        </article>
      ))
    }
  </section>

  <nav
    class="skill-navigation is-hidden"
    aria-label="Navigate between skill categories"
    aria-hidden="true"
    data-skill-navigation
  >
    <button
      class="skill-navigation-button is-unavailable"
      type="button"
      aria-label="Go to previous skill category"
      aria-hidden="true"
      disabled
      data-skill-up
    >
      <span aria-hidden="true">↑</span>
    </button>

    <span class="skill-navigation-label">
      More skills
    </span>

    <button
      class="skill-navigation-button"
      type="button"
      aria-label="Go to next skill category"
      data-skill-down
    >
      <span aria-hidden="true">↓</span>
    </button>
  </nav>
</BaseLayout>

<script>
  const skillsHero = document.querySelector(
    '[data-skills-hero]'
  );

  const skillCards = Array.from(
    document.querySelectorAll(
      '[data-skill-card]'
    )
  ).filter(
    (card) =>
      card instanceof HTMLElement
  );

  const skillNavigation =
    document.querySelector(
      '[data-skill-navigation]'
    );

  const skillUpButton =
    document.querySelector(
      '[data-skill-up]'
    );

  const skillDownButton =
    document.querySelector(
      '[data-skill-down]'
    );

  const stackedSkills =
    window.matchMedia(
      '(max-width: 1640px)'
    );

  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const compactHeroRatio = 0.6;

  let activeSkillIndex = 0;
  let skillUpdatePending = false;

  const updateSkillsHeroMode = () => {
    if (!(skillsHero instanceof HTMLElement)) {
      return;
    }

    const availableScreenWidth =
      window.screen.availWidth ||
      window.screen.width ||
      window.innerWidth;

    const compactThreshold =
      availableScreenWidth *
      compactHeroRatio;

    skillsHero.classList.toggle(
      'is-stacked',
      window.innerWidth <=
        compactThreshold
    );
  };

  const setSkillButtonAvailability = (
    button,
    isAvailable
  ) => {
    if (
      !(
        button instanceof
        HTMLButtonElement
      )
    ) {
      return;
    }

    button.disabled = !isAvailable;

    button.classList.toggle(
      'is-unavailable',
      !isAvailable
    );

    button.setAttribute(
      'aria-hidden',
      String(!isAvailable)
    );
  };

  const scrollToSkill = (
    skillIndex
  ) => {
    const targetSkill =
      skillCards[skillIndex];

    if (
      !(
        targetSkill instanceof
        HTMLElement
      )
    ) {
      return;
    }

    targetSkill.scrollIntoView({
      behavior:
        reducedMotion.matches
          ? 'auto'
          : 'smooth',
      block: 'center',
    });
  };

  const updateSkillNavigation = () => {
    if (
      !(
        skillNavigation instanceof
        HTMLElement
      ) ||
      skillCards.length === 0
    ) {
      return;
    }

    updateSkillsHeroMode();

    const navigationRangeIsVisible =
      stackedSkills.matches &&
      skillCards.some(
        (skillCard) => {
          const position =
            skillCard.getBoundingClientRect();

          return (
            position.top <
              window.innerHeight *
                0.92 &&
            position.bottom >
              window.innerHeight *
                0.08
          );
        }
      );

    skillNavigation.classList.toggle(
      'is-hidden',
      !navigationRangeIsVisible
    );

    skillNavigation.setAttribute(
      'aria-hidden',
      String(
        !navigationRangeIsVisible
      )
    );

    if (!navigationRangeIsVisible) {
      return;
    }

    const viewportCenter =
      window.innerHeight * 0.5;

    let closestDistance =
      Number.POSITIVE_INFINITY;

    skillCards.forEach(
      (skillCard, index) => {
        const position =
          skillCard.getBoundingClientRect();

        const cardCenter =
          position.top +
          position.height / 2;

        const distance =
          Math.abs(
            cardCenter -
              viewportCenter
          );

        if (
          distance >=
          closestDistance
        ) {
          return;
        }

        closestDistance = distance;
        activeSkillIndex = index;
      }
    );

    setSkillButtonAvailability(
      skillUpButton,
      activeSkillIndex > 0
    );

    setSkillButtonAvailability(
      skillDownButton,
      activeSkillIndex <
        skillCards.length - 1
    );
  };

  const requestSkillNavigationUpdate =
    () => {
      if (skillUpdatePending) {
        return;
      }

      skillUpdatePending = true;

      window.requestAnimationFrame(
        () => {
          updateSkillNavigation();
          skillUpdatePending = false;
        }
      );
    };

  const centerSkillCardAfterClick = (
    event,
    skillCard
  ) => {
    if (!stackedSkills.matches) {
      return;
    }

    if (
      !(event.target instanceof Element)
    ) {
      return;
    }

    if (
      event.target.closest(
        'a, button, input, textarea, select, label'
      )
    ) {
      return;
    }

    const selectedText =
      window.getSelection()?.toString();

    if (selectedText) {
      return;
    }

    const position =
      skillCard.getBoundingClientRect();

    const distanceFromCenter =
      position.top +
      position.height / 2 -
      window.innerHeight / 2;

    if (
      Math.abs(distanceFromCenter) < 40
    ) {
      return;
    }

    skillCard.scrollIntoView({
      behavior:
        reducedMotion.matches
          ? 'auto'
          : 'smooth',
      block: 'center',
    });
  };

  skillCards.forEach(
    (skillCard) => {
      skillCard.addEventListener(
        'click',
        (event) => {
          centerSkillCardAfterClick(
            event,
            skillCard
          );
        }
      );
    }
  );

  if (
    skillUpButton instanceof
    HTMLButtonElement
  ) {
    skillUpButton.addEventListener(
      'click',
      () => {
        scrollToSkill(
          activeSkillIndex - 1
        );
      }
    );
  }

  if (
    skillDownButton instanceof
    HTMLButtonElement
  ) {
    skillDownButton.addEventListener(
      'click',
      () => {
        scrollToSkill(
          activeSkillIndex + 1
        );
      }
    );
  }

  updateSkillsHeroMode();
  updateSkillNavigation();

  window.addEventListener(
    'scroll',
    requestSkillNavigationUpdate,
    {
      passive: true,
    }
  );

  window.addEventListener(
    'resize',
    requestSkillNavigationUpdate
  );

  window.addEventListener(
    'load',
    requestSkillNavigationUpdate
  );

  stackedSkills.addEventListener(
    'change',
    requestSkillNavigationUpdate
  );
</script>

<style>
  :global(.page-content) {
    --skills-section-spacing:
      clamp(4rem, 7vw, 6.5rem);

    padding-top:
      var(--skills-section-spacing);
    padding-bottom:
      clamp(5rem, 10vw, 9rem);
  }

  .skills-hero {
    position: relative;
    left: 50%;
    width: 60vw;
    margin: 0;
    display: grid;
    grid-template-columns:
      minmax(0, 2fr)
      minmax(0, 4fr);
    align-items: center;
    gap:
      clamp(3rem, 6vw, 6rem);
    text-align: left;
    transform: translateX(-50%);
  }

  .skills-hero h1 {
    width: fit-content;
    margin: 0;
    padding:
      0.08em
      0.16em
      0.22em
      0.04em;
    justify-self: center;
    display: inline-block;
    overflow: visible;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        #dbeafe 38%,
        var(--color-blue-light) 74%,
        var(--color-blue-bright) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color:
      transparent;
    font-size:
      clamp(3rem, 4.4vw, 5.5rem);
    line-height: 1.12;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }

  .skills-lead {
    width: 100%;
    max-width: 760px;
    margin: 0;
    justify-self: center;
    color:
      var(--color-text-secondary);
    font-size:
      clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.7;
  }

  .skills-hero.is-stacked {
    width: 80vw;
    grid-template-columns: 1fr;
    gap:
      clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
  }

  .skills-hero.is-stacked h1,
  .skills-hero.is-stacked
    .skills-lead {
    margin-inline: auto;
  }

  .skills-hero.is-stacked
    .skills-lead {
    max-width: 720px;
  }

  .skills-grid {
    position: relative;
    left: 50%;
    width: 80vw;
    margin:
      var(--skills-section-spacing)
      0
      0;
    display: grid;
    grid-template-columns:
      repeat(5, minmax(0, 1fr));
    align-items: start;
    gap:
      clamp(0.85rem, 1.6vw, 1.5rem);
    transform: translateX(-50%);
  }

  .skill-column {
    position: relative;
    min-width: 0;
    padding:
      clamp(1.4rem, 2vw, 1.85rem)
      clamp(1.2rem, 1.8vw, 1.65rem)
      clamp(1.6rem, 2.2vw, 2rem);
    overflow: hidden;
    border: 1px solid
      var(--color-border);
    border-radius:
      var(--radius-large);
    background:
      linear-gradient(
        150deg,
        rgba(18, 27, 40, 0.92),
        rgba(9, 14, 22, 0.84)
      );
    box-shadow: var(--shadow-card);
    opacity: 1;
    transform:
      translateY(0)
      scale(1);
    animation:
      reveal-skill-column
      720ms
      cubic-bezier(0.22, 1, 0.36, 1)
      backwards;
    animation-delay:
      var(--reveal-delay);
    transition:
      border-color
        var(--transition-standard),
      box-shadow
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .skill-column::before {
    position: absolute;
    top: -9rem;
    right: -9rem;
    width: 18rem;
    height: 18rem;
    content: "";
    pointer-events: none;
    border-radius: 50%;
    background:
      rgba(37, 99, 235, 0.16);
    filter: blur(3.5rem);
    opacity: 0.18;
    transition:
      opacity
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .skill-column::after {
    position: absolute;
    inset: -1px;
    content: "";
    pointer-events: none;
    border-radius: inherit;
    background:
      linear-gradient(
        145deg,
        rgba(125, 211, 252, 0.055),
        transparent 52%,
        rgba(37, 99, 235, 0.035)
      );
    opacity: 0;
    transition:
      opacity
        var(--transition-standard);
  }

  .skill-column:hover,
  .skill-column:focus-within {
    z-index: 3;
    border-color:
      var(--color-border-strong);
    box-shadow:
      0 34px 100px
        rgba(0, 0, 0, 0.42),
      0 0 3.5rem
        rgba(37, 99, 235, 0.14);
    transform:
      translateY(-0.5rem)
      scale(1.018);
  }

  .skill-column:hover::before,
  .skill-column:focus-within::before {
    opacity: 0.8;
    transform: scale(1.18);
  }

  .skill-column:hover::after,
  .skill-column:focus-within::after {
    opacity: 1;
  }

  .column-header,
  .skill-groups {
    position: relative;
    z-index: 1;
  }


  .column-header h2 {
    width: fit-content;
    margin: 0;
    color: var(--color-text);
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        #dbeafe 42%,
        var(--color-blue-light) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color:
      var(--color-text);
    font-size:
      clamp(1.45rem, 2vw, 2rem);
    font-weight: 590;
    line-height: 1.08;
    letter-spacing: -0.045em;
    transition:
      color
        var(--transition-standard),
      -webkit-text-fill-color
        var(--transition-standard);
  }

  .skill-column:hover
    .column-header h2,
  .skill-column:focus-within
    .column-header h2 {
    color: transparent;
    -webkit-text-fill-color:
      transparent;
  }

  .column-description {
    margin: 1rem 0 0;
    color:
      var(--color-text-secondary);
    font-size:
      clamp(0.8rem, 0.85vw, 0.9rem);
    line-height: 1.65;
  }

  .skill-groups {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    display: grid;
    gap: 1.8rem;
    border-top: 1px solid
      var(--color-border);
  }

  .skill-group h3 {
    margin: 0 0 0.85rem;
    color:
      var(--color-blue-light);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 570;
    letter-spacing: 0.075em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .skill-group ul {
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
    list-style: none;
  }

  .skill-group li {
    padding: 0.48rem 0.62rem;
    border: 1px solid
      var(--color-border);
    border-radius: 999px;
    color:
      var(--color-text-secondary);
    background:
      rgba(7, 9, 13, 0.38);
    font-size:
      clamp(0.68rem, 0.72vw, 0.75rem);
    line-height: 1.18;
    transition:
      color var(--transition-fast),
      border-color
        var(--transition-fast),
      background-color
        var(--transition-fast),
      transform
        var(--transition-standard);
  }

  .skill-column:hover
    .skill-group li,
  .skill-column:focus-within
    .skill-group li {
    border-color:
      rgba(96, 165, 250, 0.24);
    background:
      rgba(37, 99, 235, 0.055);
  }

  .skill-group li:hover {
    color: var(--color-text);
    border-color:
      var(--color-blue-light);
    transform:
      translateY(-0.12rem);
  }

  .skill-navigation {
    position: fixed;
    top: 50%;
    right: 0;
    z-index: 40;
    box-sizing: border-box;
    width: 10vw;
    padding-inline:
      clamp(
        0.35rem,
        0.8vw,
        0.85rem
      );
    display: flex;
    align-items: center;
    flex-direction: column;
    gap:
      clamp(
        0.45rem,
        0.8vw,
        0.7rem
      );
    visibility: visible;
    opacity: 1;
    transform:
      translateY(-50%)
      scale(1);
    transition:
      visibility
        var(--transition-standard),
      opacity
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .skill-navigation.is-hidden {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform:
      translateY(-50%)
      translateX(0.8rem)
      scale(0.95);
  }

  .skill-navigation-label {
    box-sizing: border-box;
    width: 100%;
    max-width: 7.5rem;
    min-height:
      clamp(
        3rem,
        4vw,
        4rem
      );
    padding:
      clamp(
        0.6rem,
        0.7vw,
        0.8rem
      )
      clamp(
        0.35rem,
        0.5vw,
        0.55rem
      );
    display: grid;
    place-items: center;
    border: 1px solid
      var(--color-border-strong);
    border-radius: 999px;
    color:
      var(--color-text-secondary);
    background:
      linear-gradient(
        145deg,
        rgba(18, 27, 40, 0.97),
        rgba(7, 9, 13, 0.95)
      );
    box-shadow:
      0 1.2rem 3.5rem
        rgba(0, 0, 0, 0.42),
      0 0 2rem
        rgba(37, 99, 235, 0.12);
    font-family:
      var(--font-mono);
    font-size:
      clamp(
        0.46rem,
        0.55vw,
        0.64rem
      );
    font-weight: 570;
    letter-spacing: 0.055em;
    line-height: 1.25;
    text-align: center;
    text-transform: uppercase;
  }

  .skill-navigation-button {
    width:
      clamp(
        2.6rem,
        3.2vw,
        3.5rem
      );
    height:
      clamp(
        2.6rem,
        3.2vw,
        3.5rem
      );
    padding: 0;
    display: grid;
    place-items: center;
    border: 1px solid
      var(--color-border-strong);
    border-radius: 50%;
    color:
      var(--color-blue-bright);
    background:
      linear-gradient(
        145deg,
        rgba(18, 27, 40, 0.98),
        rgba(7, 9, 13, 0.96)
      );
    box-shadow:
      0 1rem 3rem
        rgba(0, 0, 0, 0.42),
      0 0 2rem
        rgba(37, 99, 235, 0.14);
    font: inherit;
    font-size:
      clamp(
        0.95rem,
        1vw,
        1.15rem
      );
    cursor: pointer;
    transition:
      color
        var(--transition-fast),
      border-color
        var(--transition-fast),
      box-shadow
        var(--transition-standard),
      transform
        var(--transition-standard);
  }

  .skill-navigation-button:hover,
  .skill-navigation-button:focus-visible {
    color: #ffffff;
    border-color:
      var(--color-blue-bright);
    box-shadow:
      0 1.2rem 3.5rem
        rgba(0, 0, 0, 0.46),
      0 0 2.4rem
        rgba(59, 130, 246, 0.28);
    transform: scale(1.06);
  }

  .skill-navigation-button.is-unavailable {
    display: none;
  }
  @keyframes reveal-skill-column {
    from {
      opacity: 0;
      transform:
