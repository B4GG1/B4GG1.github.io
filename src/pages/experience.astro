---

<BaseLayout
  title="Experience"
  description="Professional experience of Bartosz Girzecki across software quality assurance, game development and technical education."
>
  <section
    class="experience-hero"
    aria-labelledby="experience-title"
    data-experience-hero
  >
    <h1 id="experience-title">
      Experience
    </h1>

    <p class="experience-lead">
      Several years of professional experience across software quality
      assurance, multi-platform game development, virtual reality and
      technical education — with many more challenges, technologies and
      opportunities still ahead.
    </p>
  </section>

  <a
    class="timeline-cue"
    href="#timeline-end"
    data-timeline-cue
    aria-label="Move to the end of my professional timeline"
  >
    <span class="timeline-cue-label">
      Start from the beginning
    </span>

    <span
      class="timeline-cue-arrow"
      aria-hidden="true"
    >
      ↓
    </span>
  </a>

  <section
    class="timeline"
    data-timeline
    aria-label="Professional experience timeline"
  >
    <div
      class="timeline-line"
      data-timeline-line
      aria-hidden="true"
    ></div>

    {
      experience.map((item, index) => (
        <article
          class:list={[
            'timeline-item',
            index % 2 === 0
              ? 'timeline-left'
              : 'timeline-right',
          ]}
          data-timeline-item
          data-last-item={
            index === experience.length - 1
              ? 'true'
              : undefined
          }
        >
          <div
            class="timeline-node"
            aria-hidden="true"
          >
            <span></span>
          </div>

          <div class="company-logo">
            <img
              src={item.logo}
              alt={`${item.company} logo`}
              width="512"
              height="512"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="experience-card">
            <p class="employment-period">
              {item.period}
            </p>

            <div class="card-heading">
              <h2>{item.role}</h2>

              <p class="company-name">
                <a
                  href={item.companyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.company} website — opens in a new tab`}
                >
                  {item.company}
                </a>
              </p>
            </div>

            <p class="role-summary">
              {item.summary}
            </p>

            <p class="responsibility-heading">
              Responsibilities:
            </p>

            <ul class="responsibility-list">
              {
                item.responsibilities.map(
                  (responsibility) => (
                    <li>{responsibility}</li>
                  )
                )
              }
            </ul>

            <ul
              class="tag-list"
              aria-label={`Technologies and areas used at ${item.company}`}
            >
              {
                item.tags.map((tag) => (
                  <li>{tag}</li>
                ))
              }
            </ul>
          </div>
        </article>
      ))
    }
  </section>

  <div
    id="timeline-end"
    class="timeline-end"
    aria-hidden="true"
  ></div>
</BaseLayout>

<script>
  const timelineItems = document.querySelectorAll(
    '[data-timeline-item]'
  );

  const initialTimelineItems = Array.from(
    timelineItems
  ).slice(0, 2);

  const deferredTimelineItems = Array.from(
    timelineItems
  ).slice(2);

  const initialTimelineMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const revealInitialTimelineItems = () => {
    initialTimelineItems.forEach(
      (item, index) => {
        if (!(item instanceof HTMLElement)) {
          return;
        }

        if (initialTimelineMotion.matches) {
          item.classList.add(
            'is-visible'
          );
          return;
        }

        window.setTimeout(
          () => {
            item.classList.add(
              'is-visible'
            );
          },
          120 + index * 180
        );
      }
    );
  };

  window.requestAnimationFrame(() => {
    window.requestAnimationFrame(
      revealInitialTimelineItems
    );
  });

  if ('IntersectionObserver' in window) {
    const itemObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) {
            return;
          }

          entry.target.classList.add(
            'is-visible'
          );

          itemObserver.unobserve(
            entry.target
          );
        });
      },
      {
        threshold: 0.14,
        rootMargin: '0px 0px -6% 0px',
      }
    );

    deferredTimelineItems.forEach(
      (item) => {
        itemObserver.observe(item);
      }
    );
  } else {
    deferredTimelineItems.forEach(
      (item) => {
        item.classList.add(
          'is-visible'
        );
      }
    );
  }

  const experienceHero = document.querySelector(
    '[data-experience-hero]'
  );

  const timelineCue = document.querySelector(
    '[data-timeline-cue]'
  );

  const timeline = document.querySelector(
    '[data-timeline]'
  );

  const timelineLine = document.querySelector(
    '[data-timeline-line]'
  );

  const lastCardHeading = document.querySelector(
    '[data-last-item="true"] .card-heading'
  );

  const lastTimelineItem = document.querySelector(
    '[data-last-item="true"]'
  );

  const compactTimeline = window.matchMedia(
    '(max-width: 1000px)'
  );

  let timelineGapFrame = 0;

  const equalizeTimelineColumnGaps = () => {
    window.cancelAnimationFrame(
      timelineGapFrame
    );

    timelineItems.forEach((item) => {
      if (item instanceof HTMLElement) {
        item.style.removeProperty(
          'margin-top'
        );
      }
    });

    if (compactTimeline.matches) {
      return;
    }

    timelineGapFrame =
      window.requestAnimationFrame(
        () => {
          const rightItems = Array.from(
            timelineItems
          ).filter(
            (item) =>
              item instanceof HTMLElement &&
              item.classList.contains(
                'timeline-right'
              )
          );

          if (rightItems.length < 2) {
            return;
          }

          const firstRightItem =
            rightItems[0];

          const secondRightItem =
            rightItems[1];

          if (
            !(
              firstRightItem instanceof
              HTMLElement
            ) ||
            !(
              secondRightItem instanceof
              HTMLElement
            )
          ) {
            return;
          }

          const measuredRightGap =
            secondRightItem.offsetTop -
            (
              firstRightItem.offsetTop +
              firstRightItem.offsetHeight
            );

          const desiredGap =
            measuredRightGap * 0.85;

          const previousItemBySide =
            new Map();

          timelineItems.forEach((item) => {
            if (
              !(item instanceof HTMLElement)
            ) {
              return;
            }

            const side =
              item.classList.contains(
                'timeline-left'
              )
                ? 'left'
                : 'right';

            const previousItem =
              previousItemBySide.get(side);

            if (
              previousItem instanceof
              HTMLElement
            ) {
              const currentGap =
                item.offsetTop -
                (
                  previousItem.offsetTop +
                  previousItem.offsetHeight
                );

              const currentMarginTop =
                Number.parseFloat(
                  window
                    .getComputedStyle(item)
                    .marginTop
                ) || 0;

              const correctedMarginTop =
                currentMarginTop +
                desiredGap -
                currentGap;

              item.style.marginTop =
                `${correctedMarginTop}px`;
            }

            previousItemBySide.set(
              side,
              item
            );
          });

          positionTimelineCue();
        }
      );
  };

  const compactHeroRatio = 0.6;
  const narrowCueRatio = 0.85;
  const compactCueRatio = 0.7;

  const updateExperienceHeroMode = () => {
    if (!(experienceHero instanceof HTMLElement)) {
      return;
    }

    const availableScreenWidth =
      window.screen.availWidth ||
      window.screen.width ||
      window.innerWidth;

    const compactThreshold =
      availableScreenWidth *
      compactHeroRatio;

    experienceHero.classList.toggle(
      'is-stacked',
      window.innerWidth <=
        compactThreshold
    );
  };

  const updateTimelineCueMode = () => {
    if (
      !(timelineCue instanceof HTMLAnchorElement)
    ) {
      return;
    }

    const availableScreenWidth =
      window.screen.availWidth ||
      window.screen.width ||
      window.innerWidth;

    const narrowThreshold =
      availableScreenWidth *
      narrowCueRatio;

    const compactThreshold =
      availableScreenWidth *
      compactCueRatio;

    const shouldUseCompactCue =
      window.innerWidth <=
        compactThreshold ||
      compactTimeline.matches;

    const shouldUseNarrowCue =
      window.innerWidth <=
        narrowThreshold &&
      !shouldUseCompactCue;

    timelineCue.classList.toggle(
      'is-narrow',
      shouldUseNarrowCue
    );

    timelineCue.classList.toggle(
      'is-compact',
      shouldUseCompactCue
    );

    if (shouldUseCompactCue) {
      timelineCue.style.removeProperty(
        '--timeline-cue-width'
      );

      return;
    }

    const leftCard =
      document.querySelector(
        '.timeline-left .experience-card'
      );

    const rightCard =
      document.querySelector(
        '.timeline-right .experience-card'
      );

    if (
      !(leftCard instanceof HTMLElement) ||
      !(rightCard instanceof HTMLElement)
    ) {
      timelineCue.style.removeProperty(
        '--timeline-cue-width'
      );

      return;
    }

    const leftCardPosition =
      leftCard.getBoundingClientRect();

    const rightCardPosition =
      rightCard.getBoundingClientRect();

    const centralGap =
      rightCardPosition.left -
      leftCardPosition.right;

    const safetySpace =
      shouldUseNarrowCue
        ? 64
        : 44;

    const availableCueWidth =
      Math.max(
        64,
        Math.min(
          148,
          centralGap -
            safetySpace
        )
      );

    timelineCue.style.setProperty(
      '--timeline-cue-width',
      `${availableCueWidth}px`
    );
  };

  const positionTimelineCue = () => {
    if (
      !(timelineCue instanceof HTMLAnchorElement) ||
      !(timeline instanceof HTMLElement) ||
      !(timelineLine instanceof HTMLElement)
    ) {
      return;
    }

    updateTimelineCueMode();

    const linePosition =
      timelineLine.getBoundingClientRect();

    const lineCenter =
      linePosition.left +
      linePosition.width / 2;

    timelineCue.style.left =
      `${lineCenter}px`;

    if (compactTimeline.matches) {
      timelineCue.style.top = '50%';
      return;
    }

    const timelineDocumentTop =
      timeline.getBoundingClientRect().top +
      window.scrollY;

    const preferredPosition =
      timelineDocumentTop - 24;

    const minimumPosition = 112;

    const maximumPosition =
      window.innerHeight - 64;

    const fixedPosition = Math.min(
      Math.max(
        preferredPosition,
        minimumPosition
      ),
      maximumPosition
    );

    timelineCue.style.top =
      `${fixedPosition}px`;
  };

  const updateTimelineCueVisibility = () => {
    if (
      !(timelineCue instanceof HTMLAnchorElement) ||
      !(lastCardHeading instanceof HTMLElement)
    ) {
      return;
    }

    const lastHeadingPosition =
      lastCardHeading.getBoundingClientRect();

    const shouldHide =
      lastHeadingPosition.bottom <=
      window.innerHeight - 24;

    timelineCue.classList.toggle(
      'is-hidden',
      shouldHide
    );

    timelineCue.tabIndex =
      shouldHide ? -1 : 0;

    timelineCue.setAttribute(
      'aria-hidden',
      String(shouldHide)
    );
  };

  updateExperienceHeroMode();
  equalizeTimelineColumnGaps();
  positionTimelineCue();
  updateTimelineCueVisibility();

  document.fonts.ready.then(
    equalizeTimelineColumnGaps
  );

  window.addEventListener(
    'scroll',
    updateTimelineCueVisibility,
    {
      passive: true,
    }
  );

  window.addEventListener(
    'resize',
    () => {
      updateExperienceHeroMode();
      equalizeTimelineColumnGaps();
      positionTimelineCue();
      updateTimelineCueVisibility();
    }
  );

  window.addEventListener(
    'load',
    () => {
      updateExperienceHeroMode();
      equalizeTimelineColumnGaps();
      positionTimelineCue();
      updateTimelineCueVisibility();
    }
  );

  compactTimeline.addEventListener(
    'change',
    positionTimelineCue
  );

  compactTimeline.addEventListener(
    'change',
    equalizeTimelineColumnGaps
  );
  const experienceCenteringMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  if (
    timelineCue instanceof HTMLAnchorElement &&
    lastTimelineItem instanceof HTMLElement
  ) {
    timelineCue.addEventListener(
      'click',
      (event) => {
        event.preventDefault();

        lastTimelineItem.scrollIntoView({
          behavior:
            experienceCenteringMotion.matches
              ? 'auto'
              : 'smooth',
          block: 'center',
          inline: 'nearest',
        });
      }
    );
  }

  const centerExperienceCardAfterClick = (
    event,
    experienceCard
  ) => {
    if (
      !(event.target instanceof Element)
    ) {
      return;
    }

    if (
      event.target.closest(
        'a, button, input, textarea, select, label'
      )
    ) {
      return;
    }

    const selectedText =
      window.getSelection()?.toString();

    if (selectedText) {
      return;
    }

    const position =
      experienceCard.getBoundingClientRect();

    const distanceFromCenter =
      position.top +
      position.height / 2 -
      window.innerHeight / 2;

    if (
      Math.abs(distanceFromCenter) < 40
    ) {
      return;
    }

    experienceCard.scrollIntoView({
      behavior:
        experienceCenteringMotion.matches
          ? 'auto'
          : 'smooth',
      block: 'center',
    });
  };

  timelineItems.forEach(
    (experienceCard) => {
      experienceCard.addEventListener(
        'click',
        (event) => {
          centerExperienceCardAfterClick(
            event,
            experienceCard
          );
        }
      );
    }
  );
</script>

<style>
  :global(.page-content) {
    padding-top:
      clamp(4rem, 7vw, 6.5rem);
    padding-bottom:
      clamp(5rem, 10vw, 9rem);
  }

  .experience-hero {
    position: relative;
    left: 50%;
    width: 60vw;
    margin: 0;
    display: grid;
    grid-template-columns:
      minmax(0, 2fr)
      minmax(0, 4fr);
    align-items: center;
    gap:
      clamp(3rem, 6vw, 6rem);
    transform: translateX(-50%);
  }

  .experience-hero h1 {
    width: fit-content;
    margin: 0;
    padding:
      0.08em
      0.16em
      0.22em
      0.04em;
    justify-self: center;
    display: inline-block;
    overflow: visible;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        #dbeafe 38%,
        var(--color-blue-light) 74%,
        var(--color-blue-bright) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color:
      transparent;
    font-size:
      clamp(3rem, 4.4vw, 5.5rem);
    line-height: 1.12;
    letter-spacing: -0.06em;
    white-space: nowrap;
  }

  .experience-lead {
    width: 100%;
    max-width: 760px;
    margin: 0;
    justify-self: center;
    color:
      var(--color-text-secondary);
    font-size:
      clamp(1rem, 1.45vw, 1.16rem);
    line-height: 1.7;
  }

  .experience-hero.is-stacked {
    width: 80vw;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    text-align: center;
  }

  .experience-hero.is-stacked h1,
  .experience-hero.is-stacked
    .experience-lead {
    margin-inline: auto;
  }

  .experience-hero.is-stacked
    .experience-lead {
    max-width: 720px;
  }

  .timeline {
    --timeline-gap:
      clamp(4rem, 5vw, 6rem);

    position: relative;
    left: 50%;
    width: 80vw;
    max-width: none;
    margin:
      clamp(6rem, 12vw, 10rem)
      0
      0;
    padding-bottom:
      clamp(3rem, 8vw, 7rem);
    transform: translateX(-50%);
  }

  .timeline-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 1px;
    background:
      linear-gradient(
        to bottom,
        transparent,
        var(--color-blue-light) 4rem,
        rgba(96, 165, 250, 0.38)
          calc(100% - 4rem),
        transparent
      );
    transform: translateX(-50%);
  }

  .timeline-item {
    position: relative;
    width:
      calc(
        50% - var(--timeline-gap)
      );
    margin-bottom: 0;
    opacity: 0;
    transition:
      opacity 700ms
        cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms
        cubic-bezier(0.22, 1, 0.36, 1);
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-item + .timeline-item {
    margin-top:
      calc(
        -1 *
        clamp(7rem, 10vw, 12rem)
      );
  }

  .timeline-left {
    margin-right: auto;
    transform:
      translate(-2rem, 2rem);
  }

  .timeline-right {
    top:
      clamp(
        -11rem,
        -10vw,
        -9.5rem
      );
    margin-left: auto;
    transform:
      translate(2rem, 2rem);
  }

  .timeline-item.is-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  .timeline-node {
    position: absolute;
    top: 3.2rem;
    width: var(--timeline-gap);
    height: 1px;
    background:
      linear-gradient(
        90deg,
        rgba(96, 165, 250, 0.15),
        rgba(96, 165, 250, 0.75)
      );
  }

  .timeline-left .timeline-node {
    right:
      calc(
        -1 * var(--timeline-gap)
      );
  }

  .timeline-right .timeline-node {
    left:
      calc(
        -1 * var(--timeline-gap)
      );
    transform: scaleX(-1);
  }

  .timeline-node span {
    position: absolute;
    top: 50%;
    right: -0.38rem;
    width: 0.78rem;
    height: 0.78rem;
    border: 2px solid
      var(--color-blue-light);
    border-radius: 50%;
    background: var(--color-bg);
    box-shadow:
      0 0 0 0.35rem
        rgba(59, 130, 246, 0.1),
