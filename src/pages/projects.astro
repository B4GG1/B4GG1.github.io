---
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = [
  {
    id: 'qa-automation-framework',
    status: 'Active development',
    statusType: 'active',
    title: 'Playwright Python QA Automation Framework',
    description:
      'A production-style test automation framework demonstrating maintainable architecture, realistic e-commerce coverage and CI-backed development workflows.',
    logo:
      '/assets/images/projects/Playwright Python QA Automation Framework Logo.png',
    logoAlt:
      'Playwright Python QA Automation Framework logo',
    logoScale: 1.14,
    logoOffsetX: '0%',
    logoOffsetY: '1.5%',
    technologies: [
      'Python 3.12',
      'pytest',
      'Playwright',
      'Page Object Model',
      'Ruff / Black / isort',
      'Git & GitHub',
      'GitHub Actions',
      'Html Reports',
      'WSL2 / Ubuntu',
    ],
    href:
      'https://github.com/B4GG1/playwright-python-qa-automation-framework',
  },
  {
    id: 'flask-test-management-api',
    status: 'Planned',
    statusType: 'planned',
    title: 'Flask QA Test Management API',
    description:
      'A backend application built around practical test management workflows, REST API development and automated validation.',
    logo:
      '/assets/images/projects/Flask QA Test Management API Logo.png',
    logoAlt:
      'Flask QA Test Management API logo',
    logoScale: 1,
    logoOffsetX: '0%',
    logoOffsetY: '0%',
    technologies: [
      'Python',
      'Flask',
      'REST API',
      'SQL Database',
      'pytest',
      'Backend Testing',
    ],
    href: null,
  },
  {
    id: 'django-rpg-event-platform',
    status: 'Planned',
    statusType: 'planned',
    title: 'Django RPG Event Platform',
    description:
      'An event and community platform for discovering, creating and joining tabletop role-playing game events.',
    logo:
      '/assets/images/projects/Django RPG Event Platform Logo.png',
    logoAlt:
      'Django RPG Event Platform logo',
    logoScale: 1.03,
    logoOffsetX: '0%',
    logoOffsetY: '0.8%',
    technologies: [
      'Python',
      'Django',
      'PostgreSQL',
      'Backend Testing',
      'User Accounts',
      'Event Management',
    ],
    href: null,
  },
];

const testedGames = [
  {
    title:
      'Marvel’s Guardians of the Galaxy',
    cover:
      '/assets/images/games/Guardians_of_the_galaxy.webp',
    href:
      'https://store.steampowered.com/app/1088850/Marvels_Guardians_of_the_Galaxy/',
  },
  {
    title: 'Outriders',
    cover:
      '/assets/images/games/Outriders.webp',
    href:
      'https://store.steampowered.com/app/680420/OUTRIDERS/',
  },
  {
    title: 'Marvel’s Avengers',
    cover:
      '/assets/images/games/Avengers.webp',
    href:
      'https://store.steampowered.com/app/997070/Marvels_Avengers__Edycja_Ostateczna/',
  },
  {
    title: 'Hunt Together',
    cover:
      '/assets/images/games/Hunt_Together.webp',
    href:
      'https://store.steampowered.com/app/1778030/Hunt_Together/?l=polish',
  },
  {
    title: 'The Wizards: Dark Times',
    cover:
      '/assets/images/games/The Wizards.jpg',
    href:
      'https://store.steampowered.com/app/1103860/The_Wizards__Dark_Times_Brotherhood/',
  },
  {
    title:
      'Warhammer Age of Sigmar: Tempestfall',
    cover:
      '/assets/images/games/Tempestfall.webp',
    href:
      'https://store.steampowered.com/app/1337100/Warhammer_Age_of_Sigmar_Tempestfall/',
  },
  {
    title: 'Crimen: Mercenary Tales',
    cover:
      '/assets/images/games/Crimen.webp',
    href:
      'https://store.steampowered.com/app/2436680/Crimen__Mercenary_Tales/',
  },
  {
    title: 'Mindset',
    cover:
      '/assets/images/games/Mindset.jpg',
    href:
      'https://www.meta.com/pl-pl/experiences/mindset/5981642121902237/?srsltid=AfmBOoqKW83ez_UhEDm0KKQD8iZOdP4A_O_jMkjChBruOqBS3Soawsqq',
  },
  {
    title: 'Moldwasher',
    cover:
      '/assets/images/games/Moldwasher.webp',
    href:
      'https://store.steampowered.com/app/3688130/Moldwasher/',
  },
  {
    title: 'Whispers of the Eyeless',
    cover:
      '/assets/images/games/Whisper_of_the_eyeless.jpg',
    href:
      'https://store.steampowered.com/app/2523890/Whispers_of_the_Eyeless/',
  },
  {
    title: 'Painkiller',
    cover:
      '/assets/images/games/Painkiller_2025.jpg',
    href:
      'https://store.steampowered.com/app/2300120/Painkiller/',
  },
  {
    title: 'SAW: Genesis',
    cover:
      '/assets/images/games/Saw_Genesis.jpg',
    href:
      'https://store.steampowered.com/app/2865960/SAW_Genesis/',
  },
];
---

<BaseLayout
  title="Projects"
  description="A selection of projects created and presented by Bartosz Girzecki."
>
  <section
    class="projects-hero"
    aria-labelledby="projects-title"
    data-projects-hero
  >
    <h1 id="projects-title">
      Projects
    </h1>

    <p class="projects-lead">
      Here you will find a selection of technical projects I have created, alongside games I have tested throughout my QA career.
    </p>
  </section>

  <section
    class="projects-list"
    aria-label="Selected projects"
  >
    {
      projects.map((project, index) => (
        <article
          id={project.id}
          class:list={[
            'project-entry',
            `project-${project.statusType}`,
          ]}
          style={`--reveal-delay: ${100 + index * 170}ms;`}
          data-project-card
        >
          <div class="project-emblem">
            <img
              src={`${project.logo}?v=3`}
              alt={project.logoAlt}
              style={`
                --project-logo-scale: ${project.logoScale};
                --project-logo-x: ${project.logoOffsetX};
                --project-logo-y: ${project.logoOffsetY};
              `}
              width="1024"
              height="1024"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </div>

          <div class="project-card">
            <div class="project-content">
              <div class="project-primary">
                <div class="project-copy">
                  <p
                    class:list={[
                      'project-status',
                      `project-status-${project.statusType}`,
                    ]}
                  >
                    <span aria-hidden="true"></span>
                    {project.status}
                  </p>

                  <h2>{project.title}</h2>

                  <p class="project-description">
                    {project.description}
                  </p>
                </div>

                {
                  project.href ? (
                    <a
                      class="project-link"
                      href={project.href}
                      target="_blank"
                      rel="noreferrer"
                    >
                      <span>View repository</span>
                      <span aria-hidden="true">↗</span>
                    </a>
                  ) : (
                    <span
                      class="project-link project-link-disabled"
                    >
                      Repository planned
                    </span>
                  )
                }
              </div>

              <aside
                class="project-tools"
                aria-label={`Technology stack for ${project.title}`}
              >
                <p class="tools-label">
                  Technology stack
                </p>

                <ul class="technology-list">
                  {
                    project.technologies.map(
                      (technology) => (
                        <li>{technology}</li>
                      )
                    )
                  }
                </ul>
              </aside>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section
    class="tested-games-section"
    aria-labelledby="tested-games-title"
    data-tested-games-section
  >
    <div
      class="tested-games-heading"
      data-tested-games-heading
    >
      <h2 id="tested-games-title">
        Games I Have Tested
      </h2>

      <p class="tested-games-description">
        A growing selection of game projects I have tested during my professional quality assurance career.
      </p>
    </div>

    <div
      class="tested-games-carousel"
      data-tested-games-carousel
    >
      <button
        class="tested-games-control tested-games-control-previous"
        type="button"
        aria-label="Show previous game"
        data-tested-games-previous
      >
        <span aria-hidden="true">←</span>
      </button>

      <div
        class="tested-games-viewport"
        aria-label="Games tested during my QA career"
        data-tested-games-viewport
      >
        <div
          class="tested-games-track"
          data-tested-games-track
        >
          {
            [0, 1, 2].map((groupIndex) => (
              <div
                class="tested-games-group"
                aria-hidden={
                  groupIndex === 1
                    ? 'false'
                    : 'true'
                }
                data-tested-games-group={groupIndex}
              >
                {
                  testedGames.map(
                    (game, gameIndex) => (
                      <article
                        class="tested-game-card"
                        tabindex={
                          groupIndex === 1
                            ? '0'
                            : '-1'
                        }
                        aria-label={game.title}
                        data-tested-game-card
                        data-tested-game-index={gameIndex}
                      >                        <a
                          class="tested-game-cover"
                          href={game.href}
                          target="_blank"
                          rel="noreferrer"
                          aria-label={`Open ${game.title} page`}
                          data-tested-game-link
                        >
                          <img
                            src={game.cover}
                            alt={`${game.title} cover`}
                            width="600"
                            height="900"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>

                        <div class="tested-game-copy">
                          <h3>
                            <a
                              href={game.href}
                              target="_blank"
                              rel="noreferrer"
                              data-tested-game-link
                            >
                              {game.title}
                            </a>
                          </h3>
                        </div>
                      </article>
                    )
                  )
                }
              </div>
            ))
          }
        </div>
      </div>

      <button
        class="tested-games-control tested-games-control-next"
        type="button"
        aria-label="Show next game"
        data-tested-games-next
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </section>
  <nav
    class="project-navigation is-hidden"
    aria-label="Navigate between projects"
    aria-hidden="true"
    data-project-navigation
  >
    <button
      class="project-navigation-button project-navigation-up is-unavailable"
      type="button"
      aria-label="Go to previous project"
      aria-hidden="true"
      disabled
      data-project-up
    >
      <span aria-hidden="true">↑</span>
    </button>

    <span class="project-navigation-label">
      More projects
    </span>

    <button
      class="project-navigation-button project-navigation-down"
      type="button"
      aria-label="Go to next project"
      data-project-down
    >
      <span aria-hidden="true">↓</span>
    </button>
  </nav>
</BaseLayout>

<script>
  const projectsHero =
    document.querySelector(
      '[data-projects-hero]'
    );

  const testedGamesHeading =
    document.querySelector(
      '[data-tested-games-heading]'
    );

  const testedGamesSection =
    document.querySelector(
      '[data-tested-games-section]'
    );
  const projectCards = Array.from(
    document.querySelectorAll(
      '[data-project-card]'
    )
  ).filter(
    (project) =>
      project instanceof HTMLElement
  );

  const projectNavigationTargets = [
    ...projectCards,
    ...(
      testedGamesSection instanceof
      HTMLElement
        ? [testedGamesSection]
        : []
    ),
  ];
  const projectNavigation =
    document.querySelector(
      '[data-project-navigation]'
    );

  const projectUpButton =
    document.querySelector(
      '[data-project-up]'
    );

  const projectDownButton =
    document.querySelector(
      '[data-project-down]'
    );

  const reducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const compactHeroRatio = 0.6;
  const narrowNavigationRatio = 0.85;
  const compactNavigationRatio = 0.7;

  let activeProjectIndex = 0;
  let updatePending = false;

  const getResponsiveThreshold = (
    ratio
  ) => {
    const availableScreenWidth =
      window.screen.availWidth ||
      window.screen.width ||
      window.innerWidth;

    return (
      availableScreenWidth *
      ratio
    );
  };

  const updateProjectsHeroMode =
    () => {
      const shouldUseStackedLayout =
        window.innerWidth <= 760 ||
        window.innerWidth <=
          getResponsiveThreshold(
            compactHeroRatio
          );

      if (
        projectsHero instanceof
        HTMLElement
      ) {
        projectsHero.classList.toggle(
          'is-stacked',
          shouldUseStackedLayout
        );
      }

      if (
        testedGamesHeading instanceof
        HTMLElement
      ) {
        testedGamesHeading.classList.toggle(
          'is-stacked',
          shouldUseStackedLayout
        );
      }
    };
  const updateNavigationMode = () => {
    if (
      !(
        projectNavigation instanceof
        HTMLElement
      )
    ) {
      return;
    }

    const shouldUseCompactNavigation =
      window.innerWidth <=
        getResponsiveThreshold(
          compactNavigationRatio
        );

    const shouldUseNarrowNavigation =
      window.innerWidth <=
        getResponsiveThreshold(
          narrowNavigationRatio
        ) &&
      !shouldUseCompactNavigation;

    projectNavigation.classList.toggle(
      'is-narrow',
      shouldUseNarrowNavigation
    );

    projectNavigation.classList.toggle(
      'is-compact',
      shouldUseCompactNavigation
    );
  };

  const setButtonAvailability = (
    button,
    isAvailable
  ) => {
    if (
      !(
        button instanceof
        HTMLButtonElement
      )
    ) {
      return;
    }

    button.disabled = !isAvailable;

    button.classList.toggle(
      'is-unavailable',
      !isAvailable
    );

    button.setAttribute(
      'aria-hidden',
      String(!isAvailable)
    );
  };

  const scrollToProject = (
    projectIndex
  ) => {
    const targetProject =
      projectNavigationTargets[
        projectIndex
      ];

    if (
      !(
        targetProject instanceof
        HTMLElement
      )
    ) {
      return;
    }

    const scrollBehavior =
      reducedMotion.matches
        ? 'auto'
        : 'smooth';

    if (
      targetProject ===
      testedGamesSection
    ) {
      const sectionPosition =
        targetProject.getBoundingClientRect();

      const sectionCenter =
        window.scrollY +
        sectionPosition.top +
        sectionPosition.height / 2;

      const targetScrollTop =
        Math.max(
          0,
          sectionCenter -
            window.innerHeight / 2
        );

      window.scrollTo({
        top: targetScrollTop,
        behavior: scrollBehavior,
      });

      return;
    }

    targetProject.scrollIntoView({
      behavior: scrollBehavior,
      block: 'center',
    });
  };
  const updateProjectNavigation =
    () => {
      if (
        !(
          projectNavigation instanceof
          HTMLElement
        ) ||
        projectNavigationTargets.length === 0
      ) {
        return;
      }

      updateProjectsHeroMode();
      updateNavigationMode();

      const navigationRangeIsVisible =
        projectNavigationTargets.some(
          (project) => {
            const position =
              project.getBoundingClientRect();

            return (
              position.top <
                window.innerHeight *
                  0.9 &&
              position.bottom >
                window.innerHeight *
                  0.1
            );
          }
        );

      projectNavigation.classList.toggle(
        'is-hidden',
        !navigationRangeIsVisible
      );

      projectNavigation.setAttribute(
        'aria-hidden',
        String(
          !navigationRangeIsVisible
        )
      );

      if (
        !navigationRangeIsVisible
      ) {
        return;
      }

      const viewportFocus =
        window.innerHeight * 0.5;

      let closestDistance =
        Number.POSITIVE_INFINITY;

      projectNavigationTargets.forEach(
        (project, index) => {
          const position =
            project.getBoundingClientRect();

          const projectCenter =
            position.top +
            position.height / 2;

          const distance =
            Math.abs(
              projectCenter -
                viewportFocus
            );

          if (
            distance >=
            closestDistance
          ) {
            return;
          }

          closestDistance = distance;
          activeProjectIndex = index;
        }
      );

      setButtonAvailability(
        projectUpButton,
        activeProjectIndex > 0
      );

      setButtonAvailability(
        projectDownButton,
        activeProjectIndex <
          projectNavigationTargets.length - 1
      );
    };

  const requestNavigationUpdate =
    () => {
      if (updatePending) {
        return;
      }

      updatePending = true;

      window.requestAnimationFrame(
        () => {
          updateProjectNavigation();
          updatePending = false;
        }
      );
    };

  if (
    projectUpButton instanceof
    HTMLButtonElement
  ) {
    projectUpButton.addEventListener(
      'click',
      () => {
        scrollToProject(
          activeProjectIndex - 1
        );
      }
    );
  }

  if (
    projectDownButton instanceof
    HTMLButtonElement
  ) {
    projectDownButton.addEventListener(
      'click',
      () => {
        scrollToProject(
          activeProjectIndex + 1
        );
      }
    );
  }

  window.addEventListener(
    'scroll',
    requestNavigationUpdate,
    {
      passive: true,
    }
  );

  window.addEventListener(
    'resize',
    requestNavigationUpdate
  );

  window.addEventListener(
    'load',
    requestNavigationUpdate
  );

  window.requestAnimationFrame(
    updateProjectNavigation
  );
  const centeringReducedMotion =
    window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    );

  const centerProjectCardAfterClick = (
    event,
    projectCard
  ) => {
    if (
      !(event.target instanceof Element)
    ) {
      return;
    }

    if (
      event.target.closest(
        'a, button, input, textarea, select, label'
      )
    ) {
      return;
    }

    const selectedText =
      window.getSelection()?.toString();

    if (selectedText) {
      return;
    }

    const position =
      projectCard.getBoundingClientRect();

    const distanceFromCenter =
      position.top +
      position.height / 2 -
      window.innerHeight / 2;

    if (
      Math.abs(distanceFromCenter) < 40
    ) {
      return;
    }

    projectCard.scrollIntoView({
      behavior:
        centeringReducedMotion.matches
          ? 'auto'
          : 'smooth',
      block: 'center',
    });
  };

  projectCards.forEach(
    (projectCard) => {
      projectCard.addEventListener(
        'click',
        (event) => {
          centerProjectCardAfterClick(
            event,
            projectCard
          );
        }
      );
    }
  );

  const testedGamesCarousel =
    document.querySelector(
      '[data-tested-games-carousel]'
    );

  const testedGamesViewport =
    document.querySelector(
      '[data-tested-games-viewport]'
    );

  const testedGamesPreviousButton =
    document.querySelector(
      '[data-tested-games-previous]'
    );

  const testedGamesNextButton =
    document.querySelector(
      '[data-tested-games-next]'
    );

  const testedGamesGroups = Array.from(
    document.querySelectorAll(
      '[data-tested-games-group]'
    )
  ).filter(
    (group) =>
      group instanceof HTMLElement
  );

  const testedGamesCardsByGroup =
    testedGamesGroups.map(
      (group) =>
        Array.from(
          group.querySelectorAll(
            '[data-tested-game-card]'
          )
        ).filter(
          (card) =>
            card instanceof HTMLElement
        )
    );

  const allTestedGameCards =
    testedGamesCardsByGroup.flat();

  const mainTestedGameCards =
    testedGamesCardsByGroup[1] ?? [];

  let activeTestedGameIndex = 0;
  let testedGamesIsAnimating = false;
  let testedGamesAnimationTimer = 0;
  let testedGamesUserScrollTimer = 0;

  const getTestedGamesAnimationDuration =
    () =>
      reducedMotion.matches
        ? 0
        : 560;

  const getTestedGameIndex = (
    card
  ) => {
    if (!(card instanceof HTMLElement)) {
      return 0;
    }

    const parsedIndex =
      Number.parseInt(
        card.dataset.testedGameIndex ??
          '0',
        10
      );

    return Number.isFinite(parsedIndex)
      ? parsedIndex
      : 0;
  };

  const getTestedGameGroupIndex = (
    card
  ) => {
    if (!(card instanceof HTMLElement)) {
      return 1;
    }

    const group = card.closest(
      '[data-tested-games-group]'
    );

    if (!(group instanceof HTMLElement)) {
      return 1;
    }

    const parsedIndex =
      Number.parseInt(
        group.dataset.testedGamesGroup ??
          '1',
        10
      );

    return Number.isFinite(parsedIndex)
      ? parsedIndex
      : 1;
  };

  const getTestedGameScrollPosition = (
    card
  ) => {
    if (
      !(
        testedGamesViewport instanceof
        HTMLElement
      ) ||
      !(card instanceof HTMLElement)
    ) {
      return 0;
    }

    const viewportBounds =
      testedGamesViewport.getBoundingClientRect();

    const cardBounds =
      card.getBoundingClientRect();

    const cardCenterInsideScrollArea =
      testedGamesViewport.scrollLeft +
      cardBounds.left -
      viewportBounds.left +
      cardBounds.width / 2;

    return (
      cardCenterInsideScrollArea -
      testedGamesViewport.clientWidth /
        2
    );
  };

  const moveViewportToTestedGame = (
    card,
    behavior
  ) => {
    if (
      !(
        testedGamesViewport instanceof
        HTMLElement
      ) ||
      !(card instanceof HTMLElement)
    ) {
      return;
    }

    testedGamesViewport.scrollTo({
      left:
        getTestedGameScrollPosition(
          card
        ),
      behavior,
    });
  };

  const jumpToMainTestedGame = (
    gameIndex
  ) => {
    if (
      !(
        testedGamesViewport instanceof
        HTMLElement
      )
    ) {
      return;
    }

    const mainCard =
      mainTestedGameCards[gameIndex];

    if (!(mainCard instanceof HTMLElement)) {
      return;
    }

    const previousScrollBehavior =
      testedGamesViewport.style
        .scrollBehavior;

    testedGamesViewport.style
      .scrollBehavior = 'auto';

    testedGamesViewport.scrollLeft =
      getTestedGameScrollPosition(
        mainCard
      );

    void testedGamesViewport.offsetWidth;

    window.requestAnimationFrame(
      () => {
        window.requestAnimationFrame(
          () => {
            testedGamesViewport.style
              .scrollBehavior =
                previousScrollBehavior;
          }
        );
      }
    );
  };
  const completeTestedGamesMove = (
    targetCard
  ) => {
    if (
      !(
        testedGamesViewport instanceof
        HTMLElement
      ) ||
      !(targetCard instanceof HTMLElement)
    ) {
      testedGamesIsAnimating = false;
      return;
    }

    const gameIndex =
      getTestedGameIndex(
        targetCard
      );

    const groupIndex =
      getTestedGameGroupIndex(
        targetCard
      );

    activeTestedGameIndex =
      gameIndex;

    window.clearTimeout(
      testedGamesAnimationTimer
    );

    let movementCompleted = false;

    const finishMovement = () => {
      if (movementCompleted) {
        return;
      }

      movementCompleted = true;

      testedGamesViewport.removeEventListener(
        'scrollend',
        finishMovement
      );

      window.clearTimeout(
        testedGamesAnimationTimer
      );

      if (groupIndex !== 1) {
        jumpToMainTestedGame(
          gameIndex
        );
      }

      testedGamesIsAnimating = false;
    };

    if (reducedMotion.matches) {
      finishMovement();
      return;
    }

    testedGamesViewport.addEventListener(
      'scrollend',
      finishMovement,
      {
        once: true,
      }
    );

    testedGamesAnimationTimer =
      window.setTimeout(
        finishMovement,
        900
      );
  };
  const centerTestedGameCard = (
    targetCard
  ) => {
    if (
      !(targetCard instanceof HTMLElement) ||
      testedGamesIsAnimating
    ) {
      return;
    }

    testedGamesIsAnimating = true;

    moveViewportToTestedGame(
      targetCard,
      reducedMotion.matches
        ? 'auto'
        : 'smooth'
    );

    completeTestedGamesMove(
      targetCard
    );
  };

  const moveTestedGamesCarousel = (
    direction
  ) => {
    if (
      testedGamesIsAnimating ||
      mainTestedGameCards.length === 0
    ) {
      return;
    }

    let targetGroupIndex = 1;

    let targetGameIndex =
      activeTestedGameIndex +
      direction;

    if (
      targetGameIndex >=
      mainTestedGameCards.length
    ) {
      targetGroupIndex = 2;
      targetGameIndex = 0;
    }

    if (targetGameIndex < 0) {
      targetGroupIndex = 0;

      targetGameIndex =
        mainTestedGameCards.length -
        1;
    }

    const targetCard =
      testedGamesCardsByGroup[
        targetGroupIndex
      ]?.[targetGameIndex];

    centerTestedGameCard(
      targetCard
    );
  };

  const initializeTestedGamesCarousel =
    () => {
      const firstMainCard =
        mainTestedGameCards[0];

      if (
        !(firstMainCard instanceof HTMLElement)
      ) {
        return;
      }

      activeTestedGameIndex = 0;

      moveViewportToTestedGame(
        firstMainCard,
        'auto'
      );

      if (
        testedGamesCarousel instanceof
        HTMLElement
      ) {
        testedGamesCarousel.classList.add(
          'is-ready'
        );
      }
    };

  if (
    testedGamesPreviousButton instanceof
    HTMLButtonElement
  ) {
    testedGamesPreviousButton.addEventListener(
      'click',
      () => {
        moveTestedGamesCarousel(-1);
      }
    );
  }

  if (
    testedGamesNextButton instanceof
    HTMLButtonElement
  ) {
    testedGamesNextButton.addEventListener(
      'click',
      () => {
        moveTestedGamesCarousel(1);
      }
    );
  }

  allTestedGameCards.forEach(
    (card) => {
      card.addEventListener(
        'click',
        () => {
          centerTestedGameCard(card);
        }
      );

      card.addEventListener(
        'keydown',
        (event) => {
          if (
            event.key !== 'Enter' &&
            event.key !== ' '
          ) {
            return;
          }

          event.preventDefault();

          centerTestedGameCard(card);
        }
      );
    }
  );

  const syncTestedGamesAfterUserScroll =
    () => {
      if (
        !(
          testedGamesViewport instanceof
          HTMLElement
        ) ||
        testedGamesIsAnimating
      ) {
        return;
      }

      const viewportBounds =
        testedGamesViewport
          .getBoundingClientRect();

      const viewportCenter =
        viewportBounds.left +
        viewportBounds.width / 2;

      let closestCard = null;
      let closestDistance =
        Number.POSITIVE_INFINITY;

      allTestedGameCards.forEach(
        (card) => {
          const cardBounds =
            card.getBoundingClientRect();

          const cardCenter =
            cardBounds.left +
            cardBounds.width / 2;

          const distance =
            Math.abs(
              cardCenter -
                viewportCenter
            );

          if (
            distance >=
            closestDistance
          ) {
            return;
          }

          closestDistance = distance;
          closestCard = card;
        }
      );

      if (
        !(
          closestCard instanceof
          HTMLElement
        )
      ) {
        return;
      }

      const gameIndex =
        getTestedGameIndex(
          closestCard
        );

      const groupIndex =
        getTestedGameGroupIndex(
          closestCard
        );

      activeTestedGameIndex =
        gameIndex;

      if (groupIndex !== 1) {
        jumpToMainTestedGame(
          gameIndex
        );
      }
    };

  if (
    testedGamesViewport instanceof
    HTMLElement
  ) {
    testedGamesViewport.addEventListener(
      'scroll',
      () => {
        if (testedGamesIsAnimating) {
          return;
        }

        window.clearTimeout(
          testedGamesUserScrollTimer
        );

        testedGamesUserScrollTimer =
          window.setTimeout(
            syncTestedGamesAfterUserScroll,
            180
          );
      },
      {
        passive: true,
      }
    );

    testedGamesViewport.addEventListener(
      'scrollend',
      syncTestedGamesAfterUserScroll
    );
  }
  window.addEventListener(
    'resize',
    () => {
      window.requestAnimationFrame(
        () => {
          jumpToMainTestedGame(
            activeTestedGameIndex
          );
        }
      );
    }
  );

  window.addEventListener(
    'load',
    initializeTestedGamesCarousel
  );

  window.requestAnimationFrame(
    () => {
      window.requestAnimationFrame(
        initializeTestedGamesCarousel
      );
    }
  );

  const testedGameLinks = Array.from(
    document.querySelectorAll(
      '[data-tested-game-link]'
    )
  ).filter(
    (link) =>
      link instanceof HTMLAnchorElement
  );

  testedGameLinks.forEach(
    (link) => {
      link.addEventListener(
        'click',
        (event) => {
          event.stopPropagation();
        }
      );

      link.addEventListener(
        'keydown',
        (event) => {
          event.stopPropagation();
        }
      );
    }
  );
</script>

