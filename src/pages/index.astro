---
import BaseLayout from '../layouts/BaseLayout.astro';

const sections = [
  {
    href: '/experience',
    title: 'Experience',
    description:
      'Professional background, responsibilities and practical experience.',
  },
  {
    href: '/skills',
    title: 'Skills',
    description:
      'Technical capabilities, tools and areas of continued development.',
  },
  {
    href: '/projects',
    title: 'Projects',
    description:
      'Public projects demonstrating automation and software engineering skills.',
  },
  {
    href: '/certifications',
    title: 'Certifications',
    description:
      'Professional credentials, completed programs and selected training.',
  },
  {
    href: '/contact',
    title: 'Contact',
    description:
      'Contact details, professional profiles and downloadable CV files.',
  },
];
---

<BaseLayout
  title="Home"
  description="Technical portfolio of Bartosz Girzecki, presenting professional experience, technical projects and areas of continued development."
>
  <section
    class="home-intro-viewport"
    aria-labelledby="home-title"
  >
    <div class="home-intro">
      <div class="portrait-frame">
        <div
          class="portrait-placeholder"
          data-profile-frame
        >
          <img
            src="/assets/images/home/profile/IMG20220924152057-removebg-preview.png"
            alt="Portrait of Bartosz Girzecki"
            width="550"
            height="550"
            loading="eager"
            decoding="async"
            data-profile-photo
          />

          <span data-profile-placeholder>
            Professional photo
          </span>
        </div>
      </div>

      <div class="intro-heading">
        <h1 id="home-title">
          Welcome, my name is
          <span>Bartosz Girzecki</span>
        </h1>
      </div>

      <div class="intro-description">
        <p>
          <strong>And this is my personal portfolio website.</strong>{' '}
          I’m a technical specialist with several years of professional
          experience in quality assurance, gained in the game development
          industry.{' '}
          Through that experience, supported by my personal strengths, I’ve
          developed a thoughtful, high-standard approach to product
          development, communication, collaboration, problem-solving, and
          quality.{' '}
          I’m currently expanding my skills in Python test automation,
          software engineering, and backend development, while continuing to
          develop my long-term interest in game design and game development.
        </p>
      </div>
    </div>
  </section>

  <a
    class="scroll-cue"
    href="#about-me"
    data-scroll-cue
    data-target="#about-me"
    aria-label="Read more about me"
  >
    <span data-scroll-cue-label>
      Read more about me
    </span>

    <span
      class="scroll-cue-arrow"
      aria-hidden="true"
    >
      ↓
    </span>
  </a>

  <section
    id="about-me"
    class="about-me"
    aria-labelledby="about-title"
    data-about-section
  >
    <div class="about-inner">
      <div class="about-heading">
        <h2 id="about-title">
          About me
        </h2>

        <p>
          A little more about the person behind the technical experience.
        </p>
      </div>

      <div class="about-content">
        <div class="about-copy">
          <p>
            I see myself as a curious and creative person who values
            precision, continuous development, and structured thinking.
            I enjoy understanding how things work, improving ideas, and
            turning abstract concepts into practical plans. This mindset
            also shapes the way I communicate, collaborate, and solve
            problems.
          </p>

          <p>
            Outside of work, I enjoy staying active and exploring fantasy
            through novels, video games, manga, and anime. Worlds from
            The Lord of the Rings trilogy or The Witcher Saga have stayed
            with me for years. One Piece, my favourite manga and anime, has
            had an especially strong and lasting influence on my creativity,
            persistence, and approach to personal growth.
          </p>

          <p>
            Video games have been part of my life since childhood and have
            helped shape the person I am today. Witcher 3, Skyrim, and
            Gothic 2 are just a few of my favourite games, and I have played
            hundreds of titles over the years. I’m fascinated by how games
            combine systems, storytelling, visual design, music, and player
            choice.
          </p>

          <p>
            One of my favourite creative activities is coming up with new
            game systems and mechanics. I enjoy breaking those ideas down
            into smaller elements, analysing and developing them, and
            considering how they could be implemented. I also like reading
            about new phones, computer hardware, and the practical evolution
            of technology.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section
    id="portfolio-navigation"
    class="portfolio-navigation"
    aria-labelledby="navigation-title"
  >
    <div class="navigation-inner">
      <div
        class="navigation-heading"
        data-navigation-heading
      >
        <h2 id="navigation-title">
          More to discover in my portfolio
        </h2>

        <p>
          Use the sections below to explore my professional background,
          technical capabilities and current work.
        </p>
      </div>

      <nav
        class="section-list"
        aria-label="Portfolio sections"
      >
        {
          sections.map(
            ({ href, title, description }) => (
              <a
                class="section-link"
                href={href}
              >
                <span class="section-content">
                  <strong>{title}</strong>

                  <span>{description}</span>
                </span>
              </a>
            )
          )
        }
      </nav>
    </div>
  </section>
</BaseLayout>

<script>
  const scrollCue = document.querySelector(
    '[data-scroll-cue]'
  );

  const scrollCueLabel = document.querySelector(
    '[data-scroll-cue-label]'
  );

  const aboutSection = document.querySelector(
    '[data-about-section]'
  );

  const aboutTitle = document.querySelector(
    '.about-heading h2'
  );

  const aboutHeading = document.querySelector(
    '.about-heading'
  );

  const aboutCopy = document.querySelector(
    '.about-copy'
  );

  const introDescription = document.querySelector(
    '.intro-description'
  );

  const navigationHeading = document.querySelector(
    '[data-navigation-heading]'
  );

  const profileFrame = document.querySelector(
    '[data-profile-frame]'
  );

  const profilePhoto = document.querySelector(
    '[data-profile-photo]'
  );

  const profilePlaceholder = document.querySelector(
    '[data-profile-placeholder]'
  );

  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  );

  const getHeaderHeight = () => {
    const siteHeader = document.querySelector(
      '[data-site-header], .site-header'
    );

    if (!(siteHeader instanceof HTMLElement)) {
      return 0;
    }

    return siteHeader.getBoundingClientRect().height;
  };

  let sectionGapFrame = 0;

  const equalizeHomeSectionGaps = () => {
    if (
      !(
        introDescription instanceof
        HTMLElement
      ) ||
      !(aboutSection instanceof HTMLElement) ||
      !(aboutHeading instanceof HTMLElement) ||
      !(aboutCopy instanceof HTMLElement) ||
      !(
        navigationHeading instanceof
        HTMLElement
      )
    ) {
      return;
    }

    window.cancelAnimationFrame(
      sectionGapFrame
    );

    aboutSection.style.removeProperty(
      'padding-bottom'
    );

    sectionGapFrame =
      window.requestAnimationFrame(
        () => {
          const introPosition =
            introDescription
              .getBoundingClientRect();

          const aboutHeadingPosition =
            aboutHeading
              .getBoundingClientRect();

          const aboutCopyPosition =
            aboutCopy
              .getBoundingClientRect();

          const navigationPosition =
            navigationHeading
              .getBoundingClientRect();

          const aboutContentTop =
            Math.min(
              aboutHeadingPosition.top,
              aboutCopyPosition.top
            );

          const aboutContentBottom =
            Math.max(
              aboutHeadingPosition.bottom,
              aboutCopyPosition.bottom
            );

          const firstSectionGap =
            aboutContentTop -
            introPosition.bottom;

          const secondSectionGap =
            navigationPosition.top -
            aboutContentBottom;

          const basePaddingBottom =
            Number.parseFloat(
              window
                .getComputedStyle(
                  aboutSection
                )
                .paddingBottom
            ) || 0;

          const correctedPaddingBottom =
            Math.max(
              0,
              basePaddingBottom +
                firstSectionGap -
                secondSectionGap
            );

          aboutSection.style.paddingBottom =
            `${correctedPaddingBottom}px`;
        }
      );
  };
  const getVisibleRatio = (
    element: HTMLElement
  ) => {
    const position =
      element.getBoundingClientRect();

    const visibleHeight = Math.max(
      0,
      Math.min(
        position.bottom,
        window.innerHeight
      ) -
        Math.max(position.top, 0)
    );

    const referenceHeight = Math.min(
      position.height,
      window.innerHeight
    );

    if (referenceHeight <= 0) {
      return 0;
    }

    return visibleHeight / referenceHeight;
  };

  const setScrollCueTarget = (
    target: '#about-me' |
      '#portfolio-navigation'
  ) => {
    if (
      !(scrollCue instanceof HTMLAnchorElement) ||
      !(scrollCueLabel instanceof HTMLElement)
    ) {
      return;
    }

    const exploresPortfolio =
      target === '#portfolio-navigation';

    const label = exploresPortfolio
      ? 'Explore my portfolio'
      : 'Read more about me';

    scrollCue.dataset.target = target;
    scrollCue.setAttribute('href', target);
    scrollCue.setAttribute(
      'aria-label',
      label
    );

    scrollCueLabel.textContent = label;
  };

  const updateScrollCue = () => {
    if (
      !(scrollCue instanceof HTMLAnchorElement) ||
      !(aboutSection instanceof HTMLElement) ||
      !(navigationHeading instanceof HTMLElement)
    ) {
      return;
    }

    const aboutPosition =
      aboutSection.getBoundingClientRect();

    const navigationPosition =
      navigationHeading.getBoundingClientRect();

    const hasReachedAbout =
      getVisibleRatio(aboutSection) >= 0.55 ||
      aboutPosition.top <=
        getHeaderHeight() + 24;

    const shouldHide =
      navigationPosition.top <=
      window.innerHeight * 0.88;

    setScrollCueTarget(
      hasReachedAbout
        ? '#portfolio-navigation'
        : '#about-me'
    );

    scrollCue.classList.toggle(
      'is-hidden',
      shouldHide
    );

    scrollCue.tabIndex =
      shouldHide ? -1 : 0;

    scrollCue.setAttribute(
      'aria-hidden',
      String(shouldHide)
    );
  };

  if (
    scrollCue instanceof HTMLAnchorElement
  ) {
    scrollCue.addEventListener(
      'click',
      (event) => {
        const targetSelector =
          scrollCue.dataset.target;

        if (!targetSelector) {
          return;
        }

        event.preventDefault();

        const headerHeight =
          getHeaderHeight();

        const scrollCuePosition =
          scrollCue.getBoundingClientRect();

        const buttonReserve = Math.max(
          window.innerHeight -
            scrollCuePosition.top +
            16,
          88
        );

        const viewportTop =
          headerHeight + 32;

        const viewportBottom =
          window.innerHeight -
          buttonReserve;

        const availableHeight =
          Math.max(
            viewportBottom -
              viewportTop,
            1
          );

        let targetPosition = 0;

        if (
          targetSelector === '#about-me'
        ) {
          if (
            !(aboutTitle instanceof HTMLElement) ||
            !(aboutHeading instanceof HTMLElement) ||
            !(aboutCopy instanceof HTMLElement)
          ) {
            return;
          }

          const titlePosition =
            aboutTitle.getBoundingClientRect();

          const headingPosition =
            aboutHeading.getBoundingClientRect();

          const copyPosition =
            aboutCopy.getBoundingClientRect();

          if (window.innerWidth <= 760) {
            targetPosition =
              titlePosition.top +
              window.scrollY -
              headerHeight -
              42;
          } else {
            const blockTop =
              window.innerWidth <= 1200
                ? headingPosition.top
                : copyPosition.top;

            const blockBottom =
              copyPosition.bottom;

            const blockHeight =
              blockBottom - blockTop;

            const desiredTop =
              blockHeight <= availableHeight
                ? viewportTop +
                  (
                    availableHeight -
                    blockHeight
                  ) / 2
                : viewportTop;

            targetPosition =
              blockTop +
              window.scrollY -
              desiredTop;
          }
        } else {
          if (
            !(
              navigationHeading
                instanceof HTMLElement
            )
          ) {
            return;
          }

          const navigationPosition =
            navigationHeading
              .getBoundingClientRect();

          targetPosition =
            navigationPosition.top +
            window.scrollY -
            headerHeight -
            32;
        }

        window.scrollTo({
          top: targetPosition,
          behavior: reducedMotion.matches
            ? 'auto'
            : 'smooth',
        });
      }
    );
  }

  const setProfilePhotoState = (
    isLoaded: boolean
  ) => {
    if (
      !(profileFrame instanceof HTMLElement) ||
      !(profilePlaceholder instanceof HTMLElement)
    ) {
      return;
    }

    profileFrame.classList.toggle(
      'has-photo',
      isLoaded
    );

    profilePlaceholder.setAttribute(
      'aria-hidden',
      String(isLoaded)
    );
  };

  if (profilePhoto instanceof HTMLImageElement) {
    if (profilePhoto.complete) {
      setProfilePhotoState(
        profilePhoto.naturalWidth > 0
      );
    } else {
      profilePhoto.addEventListener(
        'load',
        () => setProfilePhotoState(true),
        { once: true }
      );

      profilePhoto.addEventListener(
        'error',
        () => setProfilePhotoState(false),
        { once: true }
      );
    }
  }

  updateScrollCue();
  equalizeHomeSectionGaps();

  document.fonts.ready.then(
    equalizeHomeSectionGaps
  );

  window.addEventListener(
    'scroll',
    updateScrollCue,
    {
      passive: true,
    }
  );

  window.addEventListener(
    'resize',
    updateScrollCue
  );

  window.addEventListener(
    'load',
    updateScrollCue
  );

  window.addEventListener(
    'resize',
    equalizeHomeSectionGaps
  );

  window.addEventListener(
    'load',
    equalizeHomeSectionGaps
  );
</script>

<style>
  :global(.page-content) {
    --home-section-gap:
      clamp(6rem, 9vw, 8rem);

    padding-top: 0;
  }

  .home-intro-viewport,
  .about-me,
  .portfolio-navigation {
    position: relative;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
  }

  .home-intro {
    min-height: calc(100svh - 5.25rem);
    padding-block: clamp(2.75rem, 5vh, 4.5rem);
    display: grid;
    grid-template-columns:
      repeat(10, minmax(0, 1fr));
    grid-template-rows:
      auto
      auto;
    align-content: center;
    align-items: center;
    row-gap:
      clamp(2.75rem, 5vw, 4.75rem);
  }

  .portrait-frame {
    position: relative;
    grid-column: 3 / 5;
    grid-row: 1;
    width: min(78%, 275px);
    aspect-ratio: 1;
    padding: 0.4rem;
    justify-self: center;
    border: 1px solid
      rgba(125, 211, 252, 0.34);
    border-radius: 50%;
    background:
      linear-gradient(
        145deg,
        rgba(96, 165, 250, 0.7),
        rgba(29, 78, 216, 0.08) 45%,
        rgba(125, 211, 252, 0.45)
      );
    box-shadow:
      0 0 0 0.5rem
        rgba(59, 130, 246, 0.035),
      0 2rem 6rem
        rgba(0, 0, 0, 0.38),
      0 0 4rem
        rgba(37, 99, 235, 0.13);
  }

  .portrait-frame::after {
    position: absolute;
    inset: -1.25rem;
    z-index: -1;
    content: "";
    border-radius: 50%;
    background:
      rgba(37, 99, 235, 0.12);
    filter: blur(2.5rem);
  }

  .portrait-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 50% 32%,
        rgba(96, 165, 250, 0.2),
        transparent 30%
      ),
      linear-gradient(
        145deg,
        var(--color-surface-strong),
        var(--color-bg-soft)
      );
  }

  .portrait-placeholder img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
    opacity: 0;
    transform: scale(1.01);
    transition:
      opacity var(--transition-standard);
  }

  .portrait-placeholder span {
    position: relative;
    z-index: 1;
    max-width: 8rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
    opacity: 1;
    transition:
      opacity var(--transition-standard);
  }

  .portrait-placeholder.has-photo img {
    opacity: 1;
  }

  .portrait-placeholder.has-photo span {
    pointer-events: none;
    opacity: 0;
  }

  .intro-heading {
    min-width: 0;
    grid-column: 5 / 9;
    grid-row: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .intro-heading h1 {
    max-width: 800px;
    margin: 0;
    font-size:
      clamp(2.45rem, 3.7vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
    white-space: normal;
  }

  .intro-heading h1 span {
    display: block;
    margin-top: 0.12em;
    padding:
      0
      0.14em
      0.08em
      0.02em;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        var(--color-blue-bright),
        var(--color-blue)
      );
    -webkit-background-clip: text;
    background-clip: text;
    font-size: 1.2em;
    line-height: 0.96;
  }

  .intro-description {
    grid-column: 3 / 9;
    grid-row: 2;
    width: 100%;
    padding-inline: 2.5vw;
    justify-self: stretch;
    text-align: center;
  }

  .intro-description p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size:
      clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.8;
  }

  .intro-description strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .about-me {
    min-height: auto;
    padding:
      var(--home-section-gap)
      0
      var(--home-section-gap);
    scroll-margin-top: 6rem;
  }

  .about-inner {
    width: 100%;
    padding-inline: 10vw;
    display: grid;
    grid-template-columns:
      minmax(0, 0.82fr)
      minmax(0, 1.18fr);
    align-items: center;
    gap:
      clamp(3rem, 8vw, 8rem);
  }

  .about-heading {
    align-self: center;
  }

  .about-heading h2 {
    width: fit-content;
    margin: 0;
    padding:
      0
      0.14em
      0.08em
      0;
    overflow: visible;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        #dbeafe 45%,
        var(--color-blue-light) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    font-size:
      clamp(3rem, 6vw, 5.75rem);
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .about-heading > p {
    max-width: 25rem;
    margin:
      clamp(1.5rem, 3vw, 2.25rem)
      0
      0;
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
  }

  .about-content {
    min-width: 0;
  }

  .about-copy {
    display: grid;
    gap: 1.15rem;
  }

  .about-copy p {
    margin: 0;
    color: var(--color-text-secondary);
    font-size:
      clamp(1.04rem, 1.22vw, 1.13rem);
    line-height: 1.74;
  }

  .scroll-cue {
    position: fixed;
    bottom:
      max(
        1.5rem,
        env(safe-area-inset-bottom)
      );
    left: 50%;
    z-index: 40;
    min-height: 3.25rem;
    padding: 0.85rem 1.2rem;
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    border: 1px solid
      var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text);
    background:
      linear-gradient(
        135deg,
        rgba(18, 27, 40, 0.94),
        rgba(8, 12, 19, 0.9)
      );
    box-shadow:
      0 1rem 3rem
        rgba(0, 0, 0, 0.38),
      0 0 2rem
        rgba(37, 99, 235, 0.13);
    -webkit-backdrop-filter:
      blur(16px);
    backdrop-filter: blur(16px);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    opacity: 1;
    transform: translateX(-50%);
    transition:
      opacity var(--transition-standard),
      border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-standard);
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    border-color:
      var(--color-blue-bright);
    background:
      var(--color-surface-strong);
  }

  .scroll-cue.is-hidden {
    pointer-events: none;
    opacity: 0;
    transform:
      translate(-50%, 0.75rem);
  }

  .scroll-cue-arrow {
    color: var(--color-blue-bright);
    font-size: 1rem;
    animation:
      scroll-cue-bounce
      1.6s
      ease-in-out
      infinite;
  }

  .portfolio-navigation {
    padding-top:
      var(--home-section-gap);
    scroll-margin-top: 6rem;
  }

  .navigation-inner {
    width: 100%;
    padding-inline: 10vw;
  }

  .navigation-heading {
    width: 100%;
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    text-align: center;
  }

  .navigation-heading h2 {
    width: fit-content;
    max-width: 640px;
    margin: 0;
    padding:
      0.06em
      0.18em
      0.12em
      0.04em;
    justify-self: start;
    overflow: visible;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        #dbeafe 42%,
        var(--color-blue-light) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
    line-height: 1.08;
    text-align: left;
  }

  .navigation-heading > p {
    max-width: 600px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .section-list {
    margin-top:
      clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: 0.6rem;
  }

  .section-link {
    position: relative;
    min-width: 0;
    min-height: 8.75rem;
    padding: 1.6rem 1rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: inherit;
    background-color: transparent;
    text-decoration: none;
    transform: scale(1);
    transform-origin: center;
    transition:
      background-color
        var(--transition-standard),
      transform
        var(--transition-standard);
    will-change: transform;
  }

  .section-link::before,
  .section-link::after {
    position: absolute;
    right: 0;
    left: 0;
    height: 1px;
    content: "";
    background: var(--color-border);
    transition:
      background-color
        var(--transition-fast);
  }

  .section-link::before {
    top: 0;
  }

  .section-link::after {
    bottom: 0;
  }

  .section-link:hover,
  .section-link:focus-visible {
