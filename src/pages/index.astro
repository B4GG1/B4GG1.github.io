---
import BaseLayout from '../layouts/BaseLayout.astro';

const paths = [
  {
    number: '01',
    href: '/experience',
    title: 'Experience',
    description: 'My professional background and responsibilities.',
  },
  {
    number: '02',
    href: '/skills',
    title: 'Skills',
    description: 'Technical capabilities and areas of development.',
  },
  {
    number: '03',
    href: '/projects',
    title: 'Projects',
    description: 'Public work demonstrating practical engineering skills.',
  },
  {
    number: '04',
    href: '/certifications',
    title: 'Certifications',
    description: 'Credentials, completed programs and selected training.',
  },
  {
    number: '05',
    href: '/contact',
    title: 'Contact',
    description: 'Professional profiles, contact details and CV files.',
  },
];
---

<BaseLayout
  title="Home"
  description="Technical portfolio of Bartosz Girzecki, a QA specialist expanding into test automation, backend development and game design."
>
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow hero-eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        QA specialist / technical portfolio
      </p>

      <h1>
        Quality as a foundation.
        <span>Building beyond testing.</span>
      </h1>

      <p class="lead">
        QA specialist with several years of professional experience in
        game development, currently expanding into test automation and
        web and backend engineering. My long-term creative direction is
        centered on game design, supported by hands-on game development.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="/projects">
          View projects
          <span aria-hidden="true">→</span>
        </a>

        <a class="button button-secondary" href="/experience">
          Explore experience
        </a>
      </div>
    </div>

    <aside class="direction-panel" aria-label="Current professional direction">
      <div class="panel-heading">
        <p>Current direction</p>
        <span aria-hidden="true">●</span>
      </div>

      <dl class="direction-list">
        <div>
          <dt>Foundation</dt>
          <dd>Software quality and game QA</dd>
        </div>

        <div>
          <dt>Current focus</dt>
          <dd>Python test automation</dd>
        </div>

        <div>
          <dt>Expanding into</dt>
          <dd>Web and backend development</dd>
        </div>

        <div>
          <dt>Creative direction</dt>
          <dd>Game design and development</dd>
        </div>
      </dl>

      <div class="panel-signal" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </aside>
  </section>

  <section class="site-guide" aria-labelledby="site-guide-title">
    <div class="guide-intro">
      <p class="eyebrow">Explore the portfolio</p>

      <h2 id="site-guide-title">
        Choose the area most relevant to you.
      </h2>

      <p>
        The site is divided into focused sections, allowing you to move
        directly to my background, capabilities or practical work.
      </p>
    </div>

    <div class="guide-grid">
      {
        paths.map(({ number, href, title, description }) => (
          <a class="guide-card" href={href}>
            <span class="guide-number">{number}</span>

            <span class="guide-content">
              <strong>{title}</strong>
              <span>{description}</span>
            </span>

            <span class="guide-arrow" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    min-height: min(720px, calc(100vh - 10rem));
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(290px, 0.65fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .status-dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-blue-bright);
    box-shadow:
      0 0 0 0.25rem rgba(125, 211, 252, 0.08),
      0 0 1.2rem rgba(96, 165, 250, 0.7);
  }

  h1 {
    max-width: 930px;
    font-size: clamp(3.8rem, 8.4vw, 7.4rem);
  }

  h1 span {
    display: block;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        #ffffff 0%,
        var(--color-blue-bright) 42%,
        var(--color-blue) 100%
      );
    -webkit-background-clip: text;
    background-clip: text;
  }

  .hero-actions {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .direction-panel {
    position: relative;
    overflow: hidden;
    padding: 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-large);
    background:
      linear-gradient(
        155deg,
        rgba(18, 27, 40, 0.92),
        rgba(9, 14, 22, 0.84)
      );
    box-shadow: var(--shadow-card);
  }

  .direction-panel::before {
    position: absolute;
    top: -8rem;
    right: -8rem;
    width: 16rem;
    height: 16rem;
    content: "";
    border-radius: 50%;
    background: rgba(37, 99, 235, 0.18);
    filter: blur(3rem);
  }

  .panel-heading {
    position: relative;
    padding-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .panel-heading p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .panel-heading span {
    color: var(--color-blue-bright);
    text-shadow: 0 0 1rem var(--color-blue-light);
  }

  .direction-list {
    position: relative;
    margin: 0;
  }

  .direction-list div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .direction-list dt {
    margin-bottom: 0.35rem;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .direction-list dd {
    margin: 0;
    color: var(--color-text);
    font-size: 0.96rem;
    line-height: 1.5;
  }

  .panel-signal {
    height: 3rem;
    margin-top: 1.2rem;
    display: flex;
    align-items: flex-end;
    gap: 0.35rem;
  }

  .panel-signal span {
    width: 100%;
    border-radius: 0.2rem;
    background:
      linear-gradient(
        to top,
        rgba(37, 99, 235, 0.38),
        rgba(125, 211, 252, 0.82)
      );
  }

  .panel-signal span:nth-child(1) {
    height: 35%;
  }

  .panel-signal span:nth-child(2) {
    height: 58%;
  }

  .panel-signal span:nth-child(3) {
    height: 46%;
  }

  .panel-signal span:nth-child(4) {
    height: 78%;
  }

  .panel-signal span:nth-child(5) {
    height: 100%;
  }

  .site-guide {
    padding-top: clamp(6rem, 12vw, 11rem);
  }

  .guide-intro {
    max-width: 710px;
  }

  .guide-intro > p:last-child {
    max-width: 620px;
    margin: 1.5rem 0 0;
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .guide-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
  }

  .guide-card {
    min-height: 10rem;
    padding: 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 1.25rem;
    border-bottom: 1px solid var(--color-border);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--transition-fast),
      background-color var(--transition-standard);
  }

  .guide-card:nth-child(odd) {
    border-right: 1px solid var(--color-border);
  }

  .guide-card:hover,
  .guide-card:focus-visible {
    border-color: var(--color-border-strong);
    background:
      linear-gradient(
        135deg,
        rgba(59, 130, 246, 0.08),
        rgba(14, 20, 30, 0.5)
      );
  }

  .guide-number {
    color: var(--color-blue-light);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .guide-content {
    display: grid;
    gap: 0.65rem;
  }

  .guide-content strong {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .guide-content span {
    max-width: 340px;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .guide-arrow {
    color: var(--color-text-muted);
    transition:
      color var(--transition-fast),
      transform var(--transition-standard);
  }

  .guide-card:hover .guide-arrow {
    color: var(--color-blue-bright);
    transform: translate(0.2rem, -0.2rem);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy,
    .direction-panel,
    .site-guide {
      opacity: 0;
      animation: reveal-up 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .direction-panel {
      animation-delay: 120ms;
    }

    .site-guide {
      animation-delay: 220ms;
    }

    @keyframes reveal-up {
      from {
        opacity: 0;
        transform: translateY(1.25rem);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 900px) {
    .home-hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .direction-panel {
      max-width: 620px;
    }
  }

  @media (max-width: 700px) {
    h1 {
      font-size: clamp(3.25rem, 16vw, 5rem);
    }

    .guide-grid {
      grid-template-columns: 1fr;
    }

    .guide-card:nth-child(odd) {
      border-right: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .button {
      width: 100%;
    }

    .guide-card {
      min-height: auto;
      padding-inline: 0.75rem;
      grid-template-columns: auto 1fr;
    }

    .guide-arrow {
      display: none;
    }
  }
</style>
