---
import {
  getCommonTranslations,
  type Locale,
} from '../i18n/common';
import {
  getLocalizedPath,
} from '../i18n/helpers';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const t =
  getCommonTranslations(locale);

const currentYear =
  new Date().getFullYear();

const contactHref =
  getLocalizedPath(
    '/contact',
    locale
  );
---

<footer class="site-footer">
  <div class="shell footer-content">
    <div>
      <p class="footer-name">
        Bartosz Girzecki
      </p>

      <p class="footer-note">
        {t.footerNote}
      </p>
    </div>

    <div class="footer-meta">
      <span>
        © {currentYear}
      </span>

      <a
        href="https://github.com/B4GG1"
        target="_blank"
        rel="noreferrer"
      >
        GitHub ↗
      </a>

      <a href={contactHref}>
        {t.footerContact}
      </a>
    </div>
  </div>
</footer>